# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Old SQLite: DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/consorcio"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Secrets ───────────────────────────────────────────────────────────────────
# ATENÇÃO: este arquivo é versionado — NUNCA coloque segredos reais aqui.
# Gere valores novos com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change_me_64_hex_chars_min_32_chars_required"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
SESSION_SECRET="change_me_64_hex_chars_min_32_chars_required"

# Pepper — segredo concatenado à senha antes do hash. NUNCA commite isso em produção.
PASSWORD_PEPPER="change_me_64_hex_chars_min_16_chars_required"

# HMAC Request Signing Secret (must match Flutter request_signer.dart)
REQUEST_SIGNING_SECRET="change_me_64_hex_chars_min_32_chars_required"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (optional, omit to use default)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ── PixGo ─────────────────────────────────────────────────────────────────────
PIXGO_API_KEY="change_me_pixgo_api_key"
PIXGO_WEBHOOK_URL=https://your-tunnel.example.com

# ── Webhook ───────────────────────────────────────────────────────────────────
# Required in production (min 16 chars). Protects payment webhooks from spoofing.
PIXGO_WEBHOOK_SECRET=change_me_min_16_chars

# ── SigiloPay ─────────────────────────────────────────────────────────────────
SIGILOPAY_API_KEY="change_me_sigilopay_key"
SIGILOPAY_API_SECRET="change_me_sigilopay_secret"

# ── Admin seed credentials ────────────────────────────────────────────────────
# Conta MASTER inicial: use senha forte (24+ aleatórios) + CPF válido,
# e ative 2FA no primeiro login. O seed recusa CPF inválido.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me_24_plus_random_chars"
ADMIN_CPF="change_me_11_valid_digits"

# ── Serpro Datavalid KYC ──────────────────────────────────────────────────────
# Obtain credentials at: https://servicos.serpro.gov.br/datavalid
# Set DATAVALID_ENABLED=true only in production — keep false for local dev/testing
DATAVALID_ENABLED=false
DATAVALID_CONSUMER_KEY=your_datavalid_consumer_key
DATAVALID_CONSUMER_SECRET=your_datavalid_consumer_secret

# ── KYC VPS Storage ────────────────────────────────────────────────────────────
# Endpoint on your VPS that receives KYC audit copies (multipart/form-data POST)
# If not set, VPS upload is silently skipped
KYC_STORAGE_URL=https://your-vps.example.com/kyc/store
# HMAC-SHA256 signing secret — must match the VPS verification logic (min 32 chars)
KYC_STORAGE_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ── Local gateways (Eldorado + G2G) ───────────────────────────────────────────
# Local services that generate PIX copy-paste codes. Token goes in the
# X-Gateway-Token header on every call. Limits per gateway: min/max per
# charge (BRL), generations per minute and summed daily cap (BRL).
ELDORADO_API_URL=http://127.0.0.1:8765
ELDORADO_API_TOKEN=change_me_64_hex_chars
ELDORADO_MIN_AMOUNT=10
ELDORADO_MAX_AMOUNT=5000
ELDORADO_MAX_PER_MIN=2
ELDORADO_DAILY_CAP=20000
G2G_API_URL=http://127.0.0.1:8766
G2G_API_TOKEN=change_me_64_hex_chars
G2G_CHARACTER_NAME=
G2G_MIN_AMOUNT=50
G2G_MAX_AMOUNT=5000
G2G_MAX_PER_MIN=2
G2G_DAILY_CAP=20000
