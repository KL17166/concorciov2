# ── Serpro Datavalid KYC ──────────────────────────────────────────────────────
# Obtain credentials at: https://servicos.serpro.gov.br/datavalid
# Set DATAVALID_ENABLED=true only in production — keep false for local dev/testing
DATAVALID_ENABLED=false
DATAVALID_CONSUMER_KEY=your_datavalid_consumer_key
DATAVALID_CONSUMER_SECRET=your_datavalid_consumer_secret

# ── KYC VPS Storage ────────────────────────────────────────────────────────────
# Endpoint on your VPS that receives KYC audit copies (multipart/form-data POST)
# If not set, VPS upload is silently skipped
KYC_STORAGE_URL=https://your-vps.example.com/kyc/store
# HMAC-SHA256 signing secret — must match the VPS verification logic (min 32 chars)
KYC_STORAGE_SECRET=change_me_to_a_long_random_string_at_least_32_chars
