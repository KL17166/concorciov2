<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <h4><i class="bi bi-grid-1x2-fill"></i> Katari Admin</h4>
        <small class="text-white-50">Operação de consórcios</small>
    </div>

    <!-- Sininho de avisos -->
    <% const _bell = (typeof alertBell !== 'undefined' && alertBell) ? alertBell : { unread: 0, alerts: [] }; %>
    <div class="bell-wrap">
        <button type="button" class="bell-btn" id="bellToggle" title="Avisos do sistema">
            <i class="bi bi-bell-fill"></i>
            <span>Avisos</span>
            <% if (_bell.unread > 0) { %>
                <span class="bell-badge" id="bell-count-badge"><%= _bell.unread > 9 ? '9+' : _bell.unread %></span>
            <% } else { %>
                <span class="bell-badge" id="bell-count-badge" style="display: none;">0</span>
            <% } %>
        </button>
        <div class="bell-dropdown" id="bellDropdown" style="display: none;">
            <div class="bell-dropdown-head">
                <strong>Avisos do sistema</strong>
                <% if (_bell.unread > 0) { %>
                    <button type="button" class="bell-clear" onclick="markAllAlertsAsRead()">Marcar todas</button>
                <% } %>
            </div>
            <div class="bell-list">
                <% if (_bell.alerts.length === 0) { %>
                    <div class="bell-empty" id="bell-empty">
                        <i class="bi bi-bell-slash"></i>
                        <span>Nenhum aviso pendente.</span>
                    </div>
                <% } %>
                <% _bell.alerts.forEach(a => { %>
                    <%
                        let _d = {};
                        try { _d = a.details ? JSON.parse(a.details) : {}; } catch(e) {}
                        const _crit = a.severity === 'CRITICAL';
                    %>
                    <div class="bell-alert-item <%= _crit ? 'crit' : '' %>" id="bell-alert-<%= a.id %>" onclick="openBellAlert('<%= a.id %>', '<%= _d.subscriptionId || '' %>')">
                        <div class="bell-alert-icon <%= _crit ? 'crit' : '' %>">
                            <i class="bi <%= _crit ? 'bi-exclamation-octagon-fill' : 'bi-exclamation-triangle-fill' %>"></i>
                        </div>
                        <div class="bell-alert-body">
                            <div class="bell-alert-title"><%= a.title %></div>
                            <div class="bell-alert-msg"><%= a.message %></div>
                            <div class="bell-alert-time"><i class="bi bi-clock me-1"></i><%= new Date(a.createdAt).toLocaleString('pt-BR') %></div>
                        </div>
                        <button type="button" class="bell-dismiss" title="Dispensar" onclick="event.stopPropagation(); markAlertAsRead('<%= a.id %>')">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                <% }); %>
                <div class="bell-empty" id="bell-empty" style="<%= _bell.alerts.length === 0 ? '' : 'display: none;' %>">
                    <i class="bi bi-bell-slash"></i>
                    <span>Nenhum aviso pendente.</span>
                </div>
            </div>
        </div>
    </div>
    <style>
        .bell-wrap { position: relative; padding: 0.75rem 1rem 0.25rem 1rem; }
        .bell-btn {
            width: 100%; display: flex; align-items: center; gap: 0.6rem;
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
            color: #fff; border-radius: 10px; padding: 0.55rem 0.8rem;
            font-size: 0.88rem; font-weight: 600; cursor: pointer; position: relative;
        }
        .bell-btn:hover { background: rgba(255,255,255,0.15); }
        .bell-badge {
            margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px;
            border-radius: 11px; background: #ef4444; color: #fff;
            font-size: 0.72rem; font-weight: 800;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .bell-dropdown {
            position: absolute; top: calc(100% + 6px); left: 0.75rem;
            width: 330px; max-height: 420px; overflow-y: auto;
            background: var(--bg-secondary); border: 1px solid var(--border-color);
            border-radius: 14px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.25);
            z-index: 2000; padding: 0.5rem;
        }
        .bell-dropdown-head {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0.5rem 0.6rem; font-size: 0.9rem; color: var(--text-primary);
        }
        .bell-clear { background: none; border: none; color: #6366f1; font-size: 0.78rem; font-weight: 700; cursor: pointer; }
        .bell-list { display: flex; flex-direction: column; gap: 0.35rem; }
        .bell-alert-item {
            display: flex; gap: 0.6rem; padding: 0.6rem; border-radius: 10px;
            cursor: pointer; border-left: 4px solid #f59e0b; background: rgba(245,158,11,0.06);
        }
        .bell-alert-item.crit { border-left-color: #ef4444; background: rgba(239,68,68,0.06); }
        .bell-alert-item:hover { background: rgba(127,127,127,0.12); }
        .bell-alert-icon { font-size: 1.2rem; color: #f59e0b; flex-shrink: 0; }
        .bell-alert-icon.crit { color: #ef4444; }
        .bell-alert-body { flex: 1; min-width: 0; }
        .bell-alert-title { font-size: 0.82rem; font-weight: 800; color: var(--text-primary); }
        .bell-alert-msg {
            font-size: 0.76rem; color: var(--text-secondary); line-height: 1.4;
            display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
        }
        .bell-alert-time { font-size: 0.7rem; color: var(--text-secondary); opacity: 0.75; margin-top: 2px; }
        .bell-dismiss { background: none; border: none; color: var(--text-secondary); cursor: pointer; align-self: flex-start; padding: 2px; }
        .bell-empty { text-align: center; color: var(--text-secondary); font-size: 0.82rem; padding: 1.2rem 0.5rem; display: flex; flex-direction: column; gap: 0.3rem; align-items: center; }
    </style>
    <script>
        (function() {
            var toggle = document.getElementById('bellToggle');
            var drop = document.getElementById('bellDropdown');
            if (toggle && drop) {
                toggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    drop.style.display = drop.style.display === 'none' ? '' : 'none';
                });
                document.addEventListener('click', function(e) {
                    if (!drop.contains(e.target)) drop.style.display = 'none';
                });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') drop.style.display = 'none';
                });
            }
        })();

        function bellCsrf() {
            return '<%= (typeof csrfToken !== "undefined" && csrfToken) ? csrfToken : "" %>';
        }

        function updateBellBadge(delta) {
            var badge = document.getElementById('bell-count-badge');
            if (!badge) return;
            if (delta === 'zero') { badge.style.display = 'none'; return; }
            var cur = parseInt(badge.textContent || '0', 10) + delta;
            if (cur <= 0 || isNaN(cur)) badge.style.display = 'none';
            else { badge.style.display = ''; badge.textContent = cur > 9 ? '9+' : String(cur); }
        }

        function openBellAlert(id, subscriptionId) {
            fetch('/admin/alerts/' + id + '/read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'csrf-token': bellCsrf() }
            }).finally(function() {
                if (subscriptionId) window.location.href = '/admin/contracts/' + subscriptionId;
                else window.location.href = '/admin/dashboard';
            });
        }

        function markAlertAsRead(alertId) {
            fetch('/admin/alerts/' + alertId + '/read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'csrf-token': bellCsrf() }
            }).then(function(r) {
                if (r.ok) {
                    var item = document.getElementById('bell-alert-' + alertId);
                    if (item) item.remove();
                    updateBellBadge(-1);
                }
            }).catch(function(e) { console.error('Erro ao marcar alerta:', e); });
        }

        function markAllAlertsAsRead() {
            fetch('/admin/alerts/read-all', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'csrf-token': bellCsrf() }
            }).then(function(r) {
                if (r.ok) {
                    document.querySelectorAll('.bell-alert-item').forEach(function(el) { el.remove(); });
                    updateBellBadge('zero');
                    var empty = document.getElementById('bell-empty');
                    if (empty) empty.style.display = '';
                }
            }).catch(function(e) { console.error('Erro ao marcar todos alertas:', e); });
        }
    </script>

    <div class="sidebar-nav">
        <div class="nav-section">Visão geral</div>
        <% if (hasCapability('dashboard.view')) { %><a href="/admin/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a><% } %>

        <div class="nav-section">Operação</div>
        <% if (hasCapability('people.view')) { %><a href="/admin/people" class="<%= path === '/people' ? 'active' : '' %>"><i class="bi bi-people"></i><span>Pessoas e Contas</span></a><% } %>
        <% if (hasCapability('contracts.view')) { %><a href="/admin/contracts" class="<%= path === '/contracts' ? 'active' : '' %>"><i class="bi bi-file-earmark-text"></i><span>Contratos</span></a><% } %>
        <% if (hasCapability('support.view')) { %><a href="/admin/tickets" class="<%= path === '/tickets' ? 'active' : '' %>"><i class="bi bi-headset"></i><span>Atendimentos</span></a><% } %>
        <% if (hasCapability('payments.view')) { %><a href="/admin/payments" class="<%= path === '/payments' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i><span>Financeiro</span></a><% } %>
        <% if (hasCapability('bids.view')) { %><a href="/admin/bids" class="<%= path === '/bids' ? 'active' : '' %>"><i class="bi bi-trophy"></i><span>Lances</span></a><% } %>

        <div class="nav-section">Catálogo e análise</div>
        <% if (hasCapability('catalog.view')) { %><a href="/admin/products" class="<%= path === '/products' ? 'active' : '' %>"><i class="bi bi-box-seam"></i><span>Catálogo</span></a><% } %>
        <% if (hasCapability('reports.view')) { %><a href="/admin/reports" class="<%= path === '/reports' ? 'active' : '' %>"><i class="bi bi-bar-chart-line"></i><span>Relatórios</span></a><% } %>

        <div class="nav-section">Controle e segurança</div>
        <% if (hasCapability('compliance.view')) { %><a href="/admin/kyc" class="<%= path === '/kyc' ? 'active' : '' %>"><i class="bi bi-person-check"></i><span>Compliance / KYC</span></a><% } %>
        <% if (hasCapability('integrations.view')) { %><a href="/admin/gateways" class="<%= path === '/gateways' ? 'active' : '' %>"><i class="bi bi-plug"></i><span>Integrações</span></a><% } %>
        <% if (hasCapability('security.view')) { %><a href="/admin/security" class="<%= path === '/security' ? 'active' : '' %>"><i class="bi bi-shield-lock"></i><span>Segurança</span></a><% } %>

        <div class="nav-section">Minha conta</div>
        <% if (hasCapability('account.security')) { %><a href="/admin/profile/2fa" class="<%= path === '/profile/2fa' ? 'active' : '' %>"><i class="bi bi-shield-check"></i><span>Minha segurança</span></a><% } %>
        <a href="/admin/logout" class="text-danger"><i class="bi bi-box-arrow-left"></i><span>Sair</span></a>
    </div>
</div>
