                            </div>
                        </div>
                        <p class="text-muted small mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Produtos inativos ficam acinzentados aqui e <strong>não aparecem</strong> no app de verdade. Arraste a ordem pela tabela e salve para refletir no app.</p>
                    </div>
                    <div class="modal-footer modal-footer-premium py-3 px-4" style="background: var(--bg-secondary);">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Fechar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="deleteModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-content-premium">
                    <div class="modal-header modal-header-premium py-3 px-4" style="background: rgba(239, 68, 68, 0.1);">
                        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-trash-fill me-2"></i>Excluir Produto</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="deleteForm" method="POST" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="modal-body p-4">
                            <p class="mb-4">Tem certeza que deseja excluir o produto <strong id="deleteName" class="text-dark"></strong>?</p>
                            <div class="alert alert-danger border-0 shadow-sm" style="border-radius: 10px; background: rgba(239, 68, 68, 0.1); color: #b91c1c;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Esta ação não pode ser desfeita! Todos os planos vinculados também serão excluídos.
                            </div>
                        </div>
                        <div class="modal-footer modal-footer-premium py-3 px-4" style="background: var(--bg-secondary);">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Cancelar</button>
                            <button type="submit" class="btn btn-danger" style="border-radius: 8px;">Sim, excluir</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            // ═══════════════════════════════════════════
            // Product Search Logic
            // ═══════════════════════════════════════════
            document.addEventListener('DOMContentLoaded', () => {
                const searchInput = document.getElementById('sharedSearch');
                if (searchInput) {
                    searchInput.addEventListener('input', function(e) {
                        const term = e.target.value.trim().toLowerCase();
                        const tableRows = document.querySelectorAll('#productsTable tbody tr');
                        const cards = document.querySelectorAll('#productsCardsGrid > div');
                        let visibleRows = 0;
                        let visibleCards = 0;

                        tableRows.forEach(row => {
                            const matches = !term || row.textContent.toLowerCase().includes(term);
                            row.style.display = matches ? '' : 'none';
                            if (matches) visibleRows += 1;
                        });
                        cards.forEach(card => {
                            const matches = !term || card.textContent.toLowerCase().includes(term);
                            card.style.display = matches ? '' : 'none';
                            if (matches) visibleCards += 1;
                        });

                        const visibleCount = term ? Math.max(visibleRows, visibleCards) : <%= (typeof totals !== 'undefined' && totals) ? totals.filtered : products.length %>;
                        const countElement = document.getElementById('catalogCount');
                        if (countElement) countElement.textContent = visibleCount;
                        document.getElementById('productsTableSearchEmpty')?.classList.toggle('d-none', !term || visibleRows > 0);
                        document.getElementById('productsCardsSearchEmpty')?.classList.toggle('d-none', !term || visibleCards > 0);
                    });
                }
            });

            // ═══════════════════════════════════════════
            // View Toggle Logic
            // ═══════════════════════════════════════════
            function setView(view) {
                const btnTable = document.getElementById('btnTableView');
                const btnCards = document.getElementById('btnCardsView');
                const tbl = document.getElementById('tableView');
                const crd = document.getElementById('cardsView');

                if (view === 'table') {
                    btnTable.classList.add('active');
                    btnCards.classList.remove('active');
                    tbl.style.display = 'block';
                    crd.style.display = 'none';
                    localStorage.setItem('productsPrefView', 'table');
                } else {
                    btnCards.classList.add('active');
                    btnTable.classList.remove('active');
                    crd.style.display = 'block';
                    tbl.style.display = 'none';
                    localStorage.setItem('productsPrefView', 'cards');
                }
            }

            // Load persisted view
            document.addEventListener('DOMContentLoaded', () => {
                const p = localStorage.getItem('productsPrefView');
                if (p === 'cards') setView('cards');
            });

            // ═══════════════════════════════════════════
            // Delete Modal Logic
            // ═══════════════════════════════════════════
            function deleteProduct(id, name) {
                document.getElementById('deleteName').textContent = name || 'este produto';
                document.getElementById('deleteForm').action = '/admin/products/' + id + '/delete';
                var dm = new bootstrap.Modal(document.getElementById('deleteModal'));
                dm.show();
            }

            // ═══════════════════════════════════════════
            // Ordem do catálogo + toggles + previews
            // ═══════════════════════════════════════════
            const CSRF = '<%= csrfToken %>';
            const ALL_PRODUCTS = <%- JSON.stringify(products.map(p => ({
                id: p.id, name: p.name, brand: p.brand, model: p.model, category: p.category, type: p.type,
                price: p.price, imageUrl: p.imageUrl, active: p.active,
                isFeatured: p.isFeatured, isPopular: p.isPopular,
                displayOrder: (p.displayOrder ?? 0), estimatedMonthly: p.estimatedMonthly
            }))) %>;
            const fmtBRL = (v) => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

            function markDirty() {
                document.querySelectorAll('.order-input').forEach(i => i.classList.add('dirty'));
            }
            document.querySelectorAll('.order-input').forEach(input => {
                input.addEventListener('input', () => input.classList.add('dirty'));
                input.addEventListener('change', () => {
                    const v = parseInt(input.value, 10);
                    if (!Number.isFinite(v) || v < 0) input.value = 0;
                });
            });

            async function moveProductRow(id, direction) {
                try {
                    const res = await fetch('/admin/products/' + id + '/move', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'csrf-token': CSRF },
                        body: JSON.stringify({ direction, typeFilter: '<%= typeFilter || "" %>' })
                    });
                    const data = await res.json();
                    if (data && data.ok) {
                        location.reload();
                    } else {
                        alert((data && data.message) || 'Não foi possível mover o produto.');
                    }
                } catch (e) {
                    alert('Erro de rede ao mover o produto.');
                }
            }

            async function saveOrder() {
                const orders = [...document.querySelectorAll('.order-input')].map(i => ({
                    id: i.dataset.id, displayOrder: parseInt(i.value, 10) || 0
                }));
                const btn = document.getElementById('btnSaveOrder');
                const original = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Salvando...';
                try {
                    const res = await fetch('/admin/products/reorder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'csrf-token': CSRF },
                        body: JSON.stringify({ orders })
                    });
                    const data = await res.json();
                    if (data && data.ok) {
                        document.querySelectorAll('.order-input').forEach(i => i.classList.remove('dirty'));
                        location.reload();
                    } else {
                        alert((data && data.message) || 'Erro ao salvar ordem.');
                    }
                } catch (e) {
                    alert('Erro de rede ao salvar ordem.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = original;
                }
            }

            async function toggleFlag(id, field, btn) {
                try {
                    const res = await fetch('/admin/products/' + id + '/toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'csrf-token': CSRF },
                        body: JSON.stringify({ field })
                    });
                    if (res.status === 401 || res.status === 403) {
                        let msg = 'Sessão expirada — faça login novamente.';
                        try { const d = await res.json(); if (d && d.message) msg = d.message; } catch (_) {}
                        alert(msg);
                        if (res.status === 401 || (msg || '').toLowerCase().includes('login')) location.href = '/admin/login';
                        return;
                    }
                    const data = await res.json();
                    if (data && data.ok) {
                        location.reload();
                    } else {
                        alert((data && data.message) || 'Erro ao alternar.');
                    }
                } catch (e) {
                    alert('Erro de rede.');
                }
            }

            function miniRow(p, idx) {
                const inactive = !p.active ? 'opacity: .45; filter: grayscale(.6);' : '';
                return '<div class="d-flex align-items-center gap-2 mb-2 p-2 bg-white rounded-3" style="border: 1px solid #eee;' + inactive + '">' +
                    '<span class="fw-bold" style="width: 26px; text-align: center; color: #FF6D00;">' + (idx + 1) + 'º</span>' +
                    (p.imageUrl ? '<img src="' + p.imageUrl + '" style="width: 52px; height: 40px; border-radius: 8px; object-fit: cover; background: #eee;">' : '<div style="width: 52px; height: 40px; border-radius: 8px; background: #eee;"></div>') +
                    '<div class="flex-grow-1" style="min-width: 0;"><div class="fw-bold text-truncate" style="font-size: 13px; color: #263238;">' + escapeHtml(p.name) + '</div>' +
                    '<div style="font-size: 11px; color: #757575;">#' + p.displayOrder + ' • ' + fmtBRL(p.estimatedMonthly) + '/mês' + (!p.active ? ' • inativo' : '') + '</div></div>' +
                    (p.isFeatured ? '<span class="app-tag" style="background: #FF6D00; color: #fff;">★</span>' : '') +
                    (p.isPopular ? '<span class="app-tag" style="background: #D32F2F; color: #fff;">♥</span>' : '') +
                '</div>';
            }
            function escapeHtml(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }

            function openCatalogPreview() {
                const ordered = [...ALL_PRODUCTS].sort((a, b) => (a.displayOrder - b.displayOrder) || String(a.name).localeCompare(String(b.name)));
                const featured = ordered.filter(p => p.isFeatured).slice(0, 8);
                const popular = ordered.filter(p => p.isPopular).slice(0, 8);
                document.getElementById('catalogBestOffers').innerHTML =
                    (featured.length ? featured : ordered.slice(0, 5)).map(miniRow).join('') ||
                    '<p class="text-muted small">Nenhum produto.</p>';
                document.getElementById('catalogPopular').innerHTML =
                    (popular.length ? popular : []).map(miniRow).join('') ||
                    '<p class="text-muted small">Marque produtos como Popular para preencher esta seção.</p>';
                document.getElementById('catalogAll').innerHTML =
                    ordered.map(miniRow).join('') || '<p class="text-muted small">Nenhum produto.</p>';
                new bootstrap.Modal(document.getElementById('catalogPreviewModal')).show();
            }

            async function openProductPreview(id) {
                document.getElementById('productPreviewLoading').classList.remove('d-none');
                document.getElementById('productPreviewContent').classList.add('d-none');
                new bootstrap.Modal(document.getElementById('productPreviewModal')).show();
                try {
                    const res = await fetch('/admin/products/' + id + '/preview', { headers: { Accept: 'application/json' } });
                    const data = await res.json();
                    if (!data || !data.ok) throw new Error((data && data.message) || 'Falha ao carregar');
                    const p = data.product;
                    const img = (p.imageUrls && p.imageUrls[0]) || p.imageUrl || '';
                    const minMonthly = p.minMonthly != null ? p.minMonthly :
                        (p.plans && p.plans.length ? Math.min(...p.plans.map(x => x.monthlyInstallment)) : p.price);
                    const set = (el, v) => { document.getElementById(el).textContent = v; };
                    document.getElementById('pvCardImg').src = img;
                    document.getElementById('pvListImg').src = img;
                    document.getElementById('pvDetailImg').src = img;
                    set('pvCardName', p.name);
                    set('pvCardMonthly', fmtBRL(minMonthly));
                    set('pvListName', p.name);
                    set('pvListBrand', p.brand || 'Katari');
                    set('pvListMonthly', fmtBRL(minMonthly));
                    set('pvDetailName', p.name);
                    set('pvDetailCat', p.category || p.type);
                    set('pvDetailOrder', '#' + (p.displayOrder ?? 0) + ' no catálogo');
                    set('pvDetailPrice', fmtBRL(p.price));
                    set('pvDetailMonthly', p.plans && p.plans.length ? ('ou ' + p.plans[p.plans.length - 1].durationMonths + 'x de ' + fmtBRL(p.plans[p.plans.length - 1].monthlyInstallment)) : '');
                    document.getElementById('pvCardTag').classList.toggle('d-none', !p.isFeatured);
                    document.getElementById('pvDetailPopular').classList.toggle('d-none', !p.isPopular);
                    document.getElementById('pvDetailInactive').classList.toggle('d-none', !!p.active);
                    document.getElementById('pvDetailPlans').innerHTML = (p.plans || []).map((pl, i) =>
                        '<div class="app-plan-chip' + (i === p.plans.length - 1 ? ' sel' : '') + '"><strong>' + pl.durationMonths + ' meses</strong><br>' + fmtBRL(pl.monthlyInstallment) + '/mês</div>'
                    ).join('') || '<span class="text-muted small">Nenhum plano ativo.</span>';
                    const sections = [p.isFeatured ? 'Melhores Ofertas' : null, p.isPopular ? 'Mais Populares' : null].filter(Boolean).join(' + ') || 'só na busca';
                    document.getElementById('pvMeta').innerHTML =
                        '<strong>Posição no catálogo:</strong> #' + (p.displayOrder ?? 0) +
                        ' &nbsp;•&nbsp; <strong>Status:</strong> ' + (p.active ? 'visível no app' : 'oculto (inativo)') +
                        ' &nbsp;•&nbsp; <strong>Seções:</strong> ' + escapeHtml(sections);
                    document.getElementById('pvEditLink').href = '/admin/products/' + p.id + '/edit';
                    document.getElementById('productPreviewLoading').classList.add('d-none');
                    document.getElementById('productPreviewContent').classList.remove('d-none');
                } catch (e) {
                    document.getElementById('productPreviewLoading').innerHTML = '<p class="text-danger">Erro ao carregar pré-visualização.</p>';
                }
            }
        </script>
<%- include('../../partials/footer') %>
