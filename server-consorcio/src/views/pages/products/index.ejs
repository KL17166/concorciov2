                width: 340px; max-width: 100%; margin: 0 auto;
                background: #FAFAFA; border-radius: 28px;
                border: 10px solid #263238;
                box-shadow: 0 20px 50px rgba(0,0,0,.25);
                overflow: hidden;
            }
            .phone-notch {
                width: 120px; height: 22px; background: #263238;
                border-radius: 0 0 12px 12px; margin: 0 auto;
            }
            .phone-screen { max-height: 560px; overflow-y: auto; padding: 12px 12px 20px; font-family: 'Inter', sans-serif; }
            .app-offer-card {
                background: #fff; border-radius: 18px; overflow: hidden;
                box-shadow: 0 4px 12px rgba(0,0,0,.08); margin-bottom: 12px;
            }
            .app-offer-card img { width: 100%; height: 150px; object-fit: cover; display: block; background: #eee; }
            .app-tag {
                display: inline-block; padding: 4px 8px; border-radius: 6px;
                font-size: 10px; font-weight: 800; letter-spacing: .3px;
