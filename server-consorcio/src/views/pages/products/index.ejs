                                                    <span id="pvCardTag" class="app-tag position-absolute d-none" style="top: 10px; right: 10px; background: #FF6D00; color: #fff;">DESTAQUE</span>
                                                </div>
                                                <div style="padding: 14px;">
                                                    <div id="pvCardName" class="fw-bold" style="font-size: 15px; color: #263238;"></div>
