<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/products' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Gestão de Produtos</h1>
                    <p class="text-muted mb-0">Motos, Carros, Cartas de Crédito, Eletrônicos e mais</p>
                </div>
                <div class="top-bar-actions">
                    <!-- View Toggle -->
                    <div class="btn-group shadow-sm me-2" role="group">
                        <button type="button" class="btn btn-sm btn-outline-primary active" id="btnTableView" onclick="setView('table')" title="Tabela">
                            <i class="bi bi-list-ul"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnCardsView" onclick="setView('cards')" title="Cards">
                            <i class="bi bi-grid-3x3-gap"></i>
                        </button>
                    </div>
                    <button type="button" class="btn btn-outline-primary shadow-sm" style="border-radius: 10px;" onclick="openCatalogPreview()" title="Ver como o catálogo fica no app">
                        <i class="bi bi-phone me-2"></i>Pré-visualizar catálogo
                    </button>
                    <button type="button" class="btn btn-success shadow-sm" style="border-radius: 10px;" id="btnSaveOrder" onclick="saveOrder()" title="Salvar a ordem de exibição">
                        <i class="bi bi-sort-numeric-down me-2"></i>Salvar ordem
                    </button>
                    <a href="/admin/products/new" class="btn btn-primary shadow-sm" style="border-radius: 10px;">
                        <i class="bi bi-plus-lg me-2"></i>Novo Produto
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof success_msg !=='undefined' && success_msg && success_msg.length> 0) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error_msg !=='undefined' && error_msg && error_msg.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Stats Cards -->
            <%
            const _t = (typeof totals !== 'undefined' && totals) ? totals : null;
            const totalProducts = _t ? _t.total : products.length;
            const activeProducts = _t ? _t.active : products.filter(p => p.active).length;
            const inactiveProducts = totalProducts - activeProducts;
            const totalMotos = _t ? _t.motos : products.filter(p => p.type === 'MOTO').length;
            %>

            <div class="row g-4 mb-5">
                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Total de Produtos</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: var(--primary-color);"><%= totalProducts %></div>
                                <small class="text-muted mt-2 d-block">Cadastrados no sistema</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color);">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Produtos Ativos</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #10b981;"><%= activeProducts %></div>
                                <small class="text-muted mt-2 d-block">Disponíveis para venda</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Produtos Inativos</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #f59e0b;"><%= inactiveProducts %></div>
                                <small class="text-muted mt-2 d-block">Não visíveis no app</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-pause-circle-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Total de Motos</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #3b82f6;"><%= totalMotos %></div>
                                <small class="text-muted mt-2 d-block">Categoria principal</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                                <i class="bi bi-bicycle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Type Filter -->
            <div class="mb-4">
                <div class="btn-group shadow-sm" role="group">
                    <a href="/admin/products" class="btn btn-sm <%= !typeFilter ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius: 8px 0 0 8px;">Todos</a>
<a href="/admin/products?type=MOTO" class="btn btn-sm <%= typeFilter === 'MOTO' ? 'btn-primary' : 'btn-outline-primary' %>"><i class="bi bi-bicycle me-1"></i>Motos</a>
                    <a href="/admin/products?type=CARRO" class="btn btn-sm <%= typeFilter === 'CARRO' ? 'btn-primary' : 'btn-outline-primary' %>"><i class="bi bi-car-front me-1"></i>Carros</a>
                    <a href="/admin/products?type=CARTA_CREDITO" class="btn btn-sm <%= typeFilter === 'CARTA_CREDITO' ? 'btn-primary' : 'btn-outline-primary' %>"><i class="bi bi-credit-card me-1"></i>Cartas</a>
                    <a href="/admin/products?type=ELETRONICO" class="btn btn-sm <%= typeFilter === 'ELETRONICO' ? 'btn-primary' : 'btn-outline-primary' %>"><i class="bi bi-laptop me-1"></i>Eletrônicos</a>
                    <a href="/admin/products?type=IMOVEL" class="btn btn-sm <%= typeFilter === 'IMOVEL' ? 'btn-primary' : 'btn-outline-primary' %>"><i class="bi bi-house me-1"></i>Imóveis</a>
                    <a href="/admin/products?type=SERVICO" class="btn btn-sm <%= typeFilter === 'SERVICO' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius: 0 8px 8px 0;"><i class="bi bi-briefcase me-1"></i>Serviços</a>
                </div>
            </div>

            <!-- ORDER HINT -->
            <div class="alert border-0 shadow-sm mb-4 d-flex align-items-center gap-3" style="border-radius: 12px; background: rgba(99, 102, 241, 0.07); color: var(--text-primary);">
                <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: rgba(99,102,241,.15); color: var(--primary-color); font-size: 1.2rem;">
                    <i class="bi bi-sort-down"></i>
                </div>
                <div class="flex-grow-1">
                    <strong>Ordem do catálogo:</strong> menor número aparece primeiro no app.
                    Use <i class="bi bi-arrow-up"></i>/<i class="bi bi-arrow-down"></i> ou digite o número e clique em <strong>Salvar ordem</strong>.
                    O <i class="bi bi-eye"></i> mostra como o produto fica no catálogo.
                </div>
            </div>

            <!-- SHARED HEADER -->
            <div class="premium-info-card mb-4">
                <div class="card-header-premium d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-box-seam text-primary me-2"></i>
                        Catálogo (<span id="catalogCount"><%= (typeof totals !== 'undefined' && totals) ? totals.filtered : products.length %></span>)
                    </h5>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="text-muted small mb-0" style="white-space: nowrap;">Exibir</label>
                            <select id="sharedPerPage" class="form-select form-select-sm" style="width: auto; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border-color);">
                                <option value="12">12</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">Todos</option>
                            </select>
                            <script>
                                (function() {
                                    var sel = document.getElementById('sharedPerPage');
                                    if (!sel) return;
                                    var params = new URLSearchParams(window.location.search);
                                    sel.value = params.get('limit') || '25';
                                    if (!['12','25','50','100'].includes(sel.value)) sel.value = '25';
                                    sel.addEventListener('change', function() {
                                        params.set('limit', sel.value);
                                        params.delete('page');
                                        window.location.search = params.toString();
                                    });
                                })();
                            </script>
                            <label class="text-muted small mb-0" style="white-space: nowrap;">resultados por página</label>
                        </div>
                        <div class="position-relative" style="width: 220px;">
                            <i class="bi bi-search position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-secondary);"></i>
                            <input type="text" id="sharedSearch" class="form-control form-control-sm" placeholder="Buscar registros (Enter: servidor)"
                                value="<%= typeof q !== 'undefined' ? q : '' %>"
                                style="padding-left: 36px; border-radius: 8px; background: var(--bg-secondary); border: 1px solid var(--border-color);">
                        </div>
                        <script>
                            (function() {
                                var s = document.getElementById('sharedSearch');
                                if (!s) return;
                                s.addEventListener('keydown', function(e) {
                                    if (e.key === 'Enter') {
                                        e.preventDefault();
                                        var params = new URLSearchParams(window.location.search);
                                        if (s.value.trim()) params.set('q', s.value.trim());
                                        else params.delete('q');
                                        params.delete('page');
                                        window.location.search = params.toString();
                                    }
                                });
                            })();
                        </script>
                    </div>
                </div>
            </div>

            <!-- TABLE VIEW -->
            <div class="products-view" id="tableView">
                <div class="premium-table-container mb-4">
                    <% if (products && products.length > 0) { %>
                        <div class="p-0">
                            <div class="table-responsive">
                                <table class="table table-custom align-middle w-100" id="productsTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 130px">Ordem</th>
                                            <th style="width: 36%">Produto / Detalhes</th>
                                            <th>Valores & Prazos</th>
                                            <th>Categoria</th>
                                            <th>Status</th>
                                            <th class="text-end">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody id="productsTableBody">
                                        <% products.forEach(product => { %>
                                            <tr data-product-id="<%= product.id %>" data-order="<%= product.displayOrder ?? 0 %>">
                                                <td>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <div class="d-flex flex-column gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="moveProductRow('<%= product.id %>', 'up')" title="Subir na ordem">
                                                                <i class="bi bi-chevron-up"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="moveProductRow('<%= product.id %>', 'down')" title="Descer na ordem">
                                                                <i class="bi bi-chevron-down"></i>
                                                            </button>
                                                        </div>
                                                        <input type="number" min="0" step="10"
                                                            class="form-control form-control-sm fw-bold text-center order-input"
                                                            style="width: 70px; border-radius: 8px;"
                                                            data-id="<%= product.id %>"
                                                            value="<%= product.displayOrder ?? 0 %>"
                                                            title="Ordem de exibição (menor = primeiro)">
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-start">
                                                        <% if(product.imageUrl) { %>
                                                            <img src="<%= product.imageUrl %>" alt="" class="rounded-3 me-3 shadow-sm"
                                                                style="width: 60px; height: 60px; object-fit: cover;">
                                                        <% } else { %>
                                                            <div class="rounded-3 me-3 d-flex align-items-center justify-content-center shadow-sm"
                                                                style="width: 60px; height: 60px; background: var(--bg-secondary);">
                                                                <i class="bi bi-card-image text-muted" style="font-size: 1.2rem;"></i>
                                                            </div>
                                                        <% } %>
                                                        <div>
                                                            <div class="fw-bold text-dark"><%= product.name %></div>
                                                            <div class="small text-muted">
                                                                <% if(product.brand) { %> <%= product.brand %> <% } %>
                                                                <% if(product.model) { %> • <%= product.model %> <% } %>
                                                                <% if(product.year) { %> • <%= product.year %> <% } %>
                                                            </div>
                                                            <div class="small text-muted mt-1">
                                                                <% if(product.type === 'MOTO' && product.specs?.displacement) { %>
                                                                    <span class="badge-premium" style="background: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border-color); font-size: 0.7rem;"><%= product.specs.displacement %></span>
                                                                <% } %>
                                                                <% if(product.type === 'CARRO' && product.specs?.motor) { %>
                                                                    <span class="badge-premium" style="background: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border-color); font-size: 0.7rem;"><%= product.specs.motor %></span>
                                                                <% } %>
                                                                <% if(product.type === 'ELETRONICO' && product.specs?.processador) { %>
                                                                    <span class="badge-premium" style="background: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border-color); font-size: 0.7rem;"><%= product.specs.processador %></span>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="fw-bold" style="color: var(--success-color);">
                                                        R$ <%= Number(product.price).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                                    </div>
                                                    <div class="small text-muted mt-1">
                                                        <i class="bi bi-clock me-1"></i>
                                                        <%= product.minDuration || 12 %> a <%= product.maxDuration || 60 %> meses
                                                    </div>
                                                    <div class="small text-muted">
                                                        Taxa: <%= product.adminFeeRate || 15 %>%
                                                    </div>
                                                </td>
                                                <td>
<% const typeLabels = { MOTO: 'Moto', CARRO: 'Carro', CARTA_CREDITO: 'Carta', ELETRONICO: 'Eletrônico', IMOVEL: 'Imóvel', SERVICO: 'Serviço' }; const typeIcons = { MOTO: 'bi-bicycle', CARRO: 'bi-car-front', CARTA_CREDITO: 'bi-credit-card', ELETRONICO: 'bi-laptop', IMOVEL: 'bi-house', SERVICO: 'bi-briefcase' }; %>
                                                    <span class="badge-premium" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color); border: 1px solid rgba(99, 102, 241, 0.2);">
                                                        <i class="bi <%= typeIcons[product.type] || 'bi-box' %> me-1"></i><%= typeLabels[product.type] || product.type %>
                                                    </span>
                                                    <div class="small text-muted mt-1"><%= product.category %></div>
                                                </td>
                                                <td>
                                                    <% if(product.active) { %>
                                                        <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);"><i class="bi bi-check-circle-fill"></i>Ativo</span>
                                                    <% } else { %>
                                                        <span class="badge-premium" style="background: rgba(108, 117, 125, 0.1); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.2);"><i class="bi bi-pause-circle-fill"></i>Inativo</span>
                                                    <% } %>
                                                    <div class="d-flex gap-1 mt-2 flex-wrap">
                                                        <button type="button" class="btn btn-sm <%= product.isFeatured ? 'btn-warning' : 'btn-outline-warning' %> py-0 px-2" style="border-radius: 7px; font-size: .72rem;" onclick="toggleFlag('<%= product.id %>', 'isFeatured', this)" title="Destaque: aparece em Melhores Ofertas">
                                                            <i class="bi bi-star-fill"></i><%= product.isFeatured ? ' Destaque' : '' %>
                                                        </button>
                                                        <button type="button" class="btn btn-sm <%= product.isPopular ? 'btn-danger' : 'btn-outline-danger' %> py-0 px-2" style="border-radius: 7px; font-size: .72rem;" onclick="toggleFlag('<%= product.id %>', 'isPopular', this)" title="Popular: aparece em Mais Populares">
                                                            <i class="bi bi-fire"></i><%= product.isPopular ? ' Popular' : '' %>
                                                        </button>
                                                        <% if (product.photosAllVerified) { %>
                                                            <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); font-size: .72rem;" title="Todas as fotos conferidas por humano"><i class="bi bi-patch-check-fill"></i> Verificadas</span>
                                                        <% } else if (product.photosTotal > 0) { %>
                                                            <span class="badge-premium" style="background: rgba(245, 158, 11, 0.1); color: #b45309; border: 1px solid rgba(245, 158, 11, 0.2); font-size: .72rem;" title="Fotos extraídas por IA aguardando conferência — abra a edição"><i class="bi bi-patch-check"></i> <%= product.photosVerified %>/<%= product.photosTotal %> fotos</span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-flex justify-content-end gap-2">
                                                        <button type="button" class="btn btn-sm btn-outline-success" style="border-radius: 8px;" onclick="openProductPreview('<%= product.id %>')" title="Pré-visualizar como fica no catálogo">
                                                            <i class="bi bi-eye"></i>
                                                        </button>
                                                        <a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;" title="Editar">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;"
                                                            onclick="deleteProduct('<%= product.id %>', this.dataset.name)" data-name="<%= product.name %>" title="Excluir">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <div class="mb-4 empty-icon">
                                <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="text-dark fw-bold">Nenhum produto cadastrado</h5>
                            <p class="text-muted mb-3">Adicione o primeiro produto ao catálogo.</p>
                            <a href="/admin/products/new" class="btn btn-primary mt-2" style="border-radius: 10px;">
                                <i class="bi bi-plus-lg me-2"></i>Adicionar Primeiro Produto
                            </a>
                        </div>
                    <% } %>
                    <div id="productsTableSearchEmpty" class="text-center py-5 d-none">
                        <div class="mb-3 d-inline-block p-3 rounded-circle" style="background: rgba(99, 102, 241, 0.1);">
                            <i class="bi bi-search text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <h5 class="text-dark fw-bold">Nenhum resultado encontrado</h5>
                        <p class="text-muted mb-0">Tente buscar por outro nome, categoria ou característica.</p>
                    </div>
                </div>
                <!-- Table Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3 px-1" id="productsTablePagination" style="display: none;">
                    <small class="text-muted" id="productsTableInfo"></small>
                    <nav><ul class="pagination pagination-sm mb-0" id="productsTablePager"></ul></nav>
                </div>
            </div>

            <!-- CARDS VIEW -->
            <div class="products-view" id="cardsView" style="display: none;">
                <% if (products && products.length > 0) { %>
                    <div class="row g-4" id="productsCardsGrid">
                        <% products.forEach(product => { %>
                            <div class="col-md-4 col-lg-3" data-product-id="<%= product.id %>">
                                <div class="premium-stat-card h-100" style="overflow: hidden;">
                                    <!-- Product Image -->
                                    <% if(product.imageUrl) { %>
                                        <div style="height: 160px; overflow: hidden; border-bottom: 1px solid var(--border-color); position: relative;">
                                            <img src="<%= product.imageUrl %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                                            <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75" title="Ordem no catálogo">#<%= product.displayOrder ?? 0 %></span>
                                        </div>
                                    <% } else { %>
                                        <div style="height: 120px; background: linear-gradient(135deg, var(--bg-secondary), var(--bg-primary)); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--border-color);">
                                            <i class="bi bi-box-seam" style="font-size: 3rem; opacity: 0.15;"></i>
                                        </div>
                                    <% } %>

                                    <div class="p-3">
                                        <!-- Status Badge (top-right) -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
<% const typeLabelsCard = { MOTO: 'Moto', CARRO: 'Carro', CARTA_CREDITO: 'Carta', ELETRONICO: 'Eletrônico', IMOVEL: 'Imóvel', SERVICO: 'Serviço' }; const typeIconsCard = { MOTO: 'bi-bicycle', CARRO: 'bi-car-front', CARTA_CREDITO: 'bi-credit-card', ELETRONICO: 'bi-laptop', IMOVEL: 'bi-house', SERVICO: 'bi-briefcase' }; %>
                                                <span class="badge-premium" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color); border: 1px solid rgba(99, 102, 241, 0.2); font-size: 0.7rem;">
                                                    <i class="bi <%= typeIconsCard[product.type] || 'bi-box' %> me-1"></i><%= typeLabelsCard[product.type] || product.type %>
                                                </span>
                                            </div>
                                            <% if(product.active) { %>
                                                <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); font-size: 0.7rem;"><i class="bi bi-check-circle-fill"></i>Ativo</span>
                                            <% } else { %>
                                                <span class="badge-premium" style="background: rgba(108, 117, 125, 0.1); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.2); font-size: 0.7rem;"><i class="bi bi-pause-circle-fill"></i>Inativo</span>
                                            <% } %>
                                            <% if (product.photosAllVerified) { %>
                                                <span class="badge-premium ms-1" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); font-size: 0.7rem;" title="Todas as fotos conferidas"><i class="bi bi-patch-check-fill"></i></span>
                                            <% } else if (product.photosTotal > 0) { %>
                                                <span class="badge-premium ms-1" style="background: rgba(245, 158, 11, 0.1); color: #b45309; border: 1px solid rgba(245, 158, 11, 0.2); font-size: 0.7rem;" title="<%= product.photosVerified %>/<%= product.photosTotal %> fotos conferidas — abra a edição"><i class="bi bi-patch-check"></i></span>
                                            <% } %>
                                        </div>

                                        <!-- Name & Details -->
                                        <h6 class="fw-bold mb-1" style="font-size: 0.95rem;"><%= product.name %></h6>
                                        <div class="small text-muted mb-2">
                                            <% if(product.brand) { %><%= product.brand %><% } %>
                                            <% if(product.model) { %> • <%= product.model %><% } %>
                                            <% if(product.year) { %> • <%= product.year %><% } %>
                                        </div>

                                        <!-- Price -->
                                        <div class="mb-2">
                                            <div class="info-label">Crédito</div>
                                            <div class="fw-bold" style="font-size: 1.2rem; color: var(--success-color);">
                                                R$ <%= Number(product.price).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                            </div>
                                        </div>

                                        <!-- Duration & Fee -->
                                        <div class="d-flex gap-3 mb-3">
                                            <div>
                                                <div class="info-label">Prazo</div>
                                                <div class="small fw-semibold"><%= product.minDuration || 12 %> – <%= product.maxDuration || 60 %> meses</div>
                                            </div>
                                            <div>
                                                <div class="info-label">Taxa</div>
                                                <div class="small fw-semibold"><%= product.adminFeeRate || 15 %>%</div>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-success" style="border-radius: 8px;" onclick="openProductPreview('<%= product.id %>')" title="Pré-visualizar no catálogo">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-outline-primary flex-1" style="border-radius: 8px;">
                                                <i class="bi bi-pencil me-1"></i>Editar
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;"
                                                onclick="deleteProduct('<%= product.id %>', '<%= product.name %>')" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <div class="mb-4 empty-icon">
                            <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="text-dark fw-bold">Nenhum produto cadastrado</h5>
                        <p class="text-muted mb-3">Adicione o primeiro produto ao catálogo.</p>
                        <a href="/admin/products/new" class="btn btn-primary mt-2" style="border-radius: 10px;">
                            <i class="bi bi-plus-lg me-2"></i>Adicionar Primeiro Produto
                        </a>
                    </div>
                <% } %>
                <div id="productsCardsSearchEmpty" class="text-center py-5 d-none">
                    <div class="mb-3 d-inline-block p-3 rounded-circle" style="background: rgba(99, 102, 241, 0.1);">
                        <i class="bi bi-search text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <h5 class="text-dark fw-bold">Nenhum resultado encontrado</h5>
                    <p class="text-muted mb-0">Tente buscar por outro nome, categoria ou característica.</p>
                </div>
                <!-- Cards Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3 px-1" id="productsCardsPagination" style="display: none;">
                    <small class="text-muted" id="productsCardsInfo"></small>
                    <nav><ul class="pagination pagination-sm mb-0" id="productsCardsPager"></ul></nav>
                </div>
            </div>

            <div class="mb-5"></div>
        </div>

        <style>
            /* ── Pré-visualização estilo app (zuvio) ── */
