                                            <h5 id="pvDetailName" class="fw-bold mb-1" style="color: #263238;"></h5>
                                            <div class="d-flex gap-2 mb-2">
                                                <span id="pvDetailCat" class="app-tag" style="background: #FF6D00; color: #fff;"></span>
                                                <span id="pvDetailPopular" class="app-tag d-none" style="background: #D32F2F; color: #fff;">POPULAR</span>
                                                <span id="pvDetailInactive" class="app-tag d-none" style="background: #6c757d; color: #fff;">INATIVO — oculto no app</span>
                                            </div>
                                            <div style="font-size: 14px; color: #9E9E9E;">Valor do Consórcio</div>
                                            <div id="pvDetailPrice" class="fw-bold" style="font-size: 30px; color: #263238;"></div>
                                            <div id="pvDetailMonthly" style="font-size: 14px; color: #616161;"></div>
                                            <div id="pvDetailPlans" class="d-flex flex-wrap gap-2 mt-3"></div>
