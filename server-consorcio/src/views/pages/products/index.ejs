                    <div class="modal-footer modal-footer-premium py-3 px-4" style="background: var(--bg-secondary);">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Fechar</button>
                        <a href="#" id="pvEditLink" class="btn btn-primary" style="border-radius: 8px;"><i class="bi bi-pencil me-1"></i>Editar produto</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Catalog Order Preview Modal (ordem geral) -->
        <div class="modal fade" id="catalogPreviewModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-content-premium">
                    <div class="modal-header modal-header-premium py-3 px-4" style="background: rgba(99, 102, 241, 0.1);">
                        <h5 class="modal-title fw-bold"><i class="bi bi-phone me-2"></i>Ordem do catálogo no app</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="phone-frame">
                            <div class="phone-notch"></div>
                            <div class="phone-screen">
                                <h6 class="fw-bold mb-2" style="color: #263238;">Melhores Ofertas <small class="text-muted fw-normal">(destaques, na sua ordem)</small></h6>
                                <div id="catalogBestOffers"></div>
                                <h6 class="fw-bold mt-3 mb-2" style="color: #263238;">Mais Populares <small class="text-muted fw-normal">(populares, na sua ordem)</small></h6>
