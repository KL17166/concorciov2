<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/products' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">
                        <%= editing ? 'Editar Produto' : 'Novo Produto' %>
                    </h1>
                    <p class="text-muted mb-0">
                        <%= editing ? 'Atualize as informações do produto' : 'Adicione um novo produto ao catálogo' %>
                    </p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/products" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof error_msg !=='undefined' && error_msg && error_msg.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <!-- Form Container -->
                    <div class="table-container">
                        <form id="productForm"
                            action="<%= editing ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>"
                            method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <!-- Informações Básicas Card -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="bi bi-info-circle text-primary me-2"></i>
                                        Informações Básicas
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-5">
                                            <label class="form-label fw-semibold">Nome do Produto *</label>
                                            <input type="text" name="name" class="form-control" value="<%= product.name || '' %>" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold">Preço (R$) *</label>
                                            <div class="input-group">
                                                <span class="input-group-text">R$</span>
                                                <input type="number" step="0.01" name="price" class="form-control" value="<%= product.price || '' %>" required>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Marca / Modelo / Ano</label>
                                            <div class="row g-2">
                                                <div class="col-5">
                                                    <input type="text" name="brand" class="form-control" placeholder="Marca" value="<%= product.brand || '' %>">
                                                </div>
                                                <div class="col-4">
                                                    <input type="text" name="model" class="form-control" placeholder="Modelo" value="<%= product.model || '' %>">
                                                </div>
                                                <div class="col-3">
                                                    <input type="number" name="year" class="form-control" placeholder="Ano" value="<%= product.year || '' %>">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Descrição</label>
                                            <textarea name="description" class="form-control" rows="3"><%= product.description || '' %></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Classificação e Display Card -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="bi bi-tags text-primary me-2"></i>
                                        Classificação e Display
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold">Tipo de Produto *</label>
                                            <select name="type" class="form-select" id="typeSelect">
                                                <option value="MOTO" <%=product.type==='MOTO' ? 'selected' : '' %>>Moto</option>
                                                <option value="CARRO" <%=product.type==='CARRO' ? 'selected' : '' %>>Carro</option>
                                                <option value="CARTA_CREDITO" <%=product.type==='CARTA_CREDITO' ? 'selected' : '' %>>Carta de Crédito</option>
                                                <option value="ELETRONICO" <%=product.type==='ELETRONICO' ? 'selected' : '' %>>Eletrônico</option>
                                                <option value="IMOVEL" <%=product.type==='IMOVEL' ? 'selected' : '' %>>Imóvel</option>
                                                <option value="SERVICO" <%=product.type==='SERVICO' ? 'selected' : '' %>>Serviço</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Categoria Específica *</label>
                                            <input type="hidden" name="category" id="categoryHiddenInputValue" value="<%= product.category || '' %>">
                                            <select class="form-select" id="categorySelect" required>
                                                <!-- Populated by JS -->
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label fw-semibold" title="Menor número aparece primeiro no app">Ordem *</label>
                                            <input type="number" name="displayOrder" id="displayOrderInput" class="form-control fw-bold" min="0" step="10" value="<%= (typeof product.displayOrder !== 'undefined' && product.displayOrder !== null) ? product.displayOrder : (typeof nextDisplayOrder !== 'undefined' ? nextDisplayOrder : 0) %>" required>
                                            <div class="form-text">Menor = primeiro</div>
                                        </div>
                                        <div class="col-md-3 d-flex flex-column justify-content-center">
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" name="isFeatured" id="isFeaturedCheck" <%=product.isFeatured ? 'checked' : '' %>>
                                                <label class="form-check-label ms-2" for="isFeaturedCheck">
                                                    <strong>Destaque</strong> <small class="text-muted">(Melhores Ofertas)</small>
                                                </label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" name="isPopular" id="isPopularCheck" <%=product.isPopular ? 'checked' : '' %>>
                                                <label class="form-check-label ms-2" for="isPopularCheck">
                                                    <strong>Popular</strong> <small class="text-muted">(Mais Populares)</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Galeria de Imagens Card -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="bi bi-images text-primary me-2"></i>
                                        Galeria de Imagens
                                    </h5>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="addImageBtn">
                                        <i class="bi bi-plus-lg me-1"></i>Adicionar Imagem
                                    </button>
                                </div>
                                <div class="card-body">
                                    <!-- Hidden primary inputs generated at submit -->
                                    <input type="hidden" name="imageUrl" id="mainImageUrlHidden">
                                    <input type="hidden" name="imageUrls" id="imageUrlsArrayHidden">
                                    
                                    <div id="imageUrlsContainer">
                                        <!-- Inputs populated by JS based on product.imageUrls -->
                                    </div>
                                    <style>
                                        .gallery-thumb { width: 56px; height: 56px; object-fit: cover; border-radius: 10px; border: 1px solid var(--border-color); flex-shrink: 0; background: #eee; }
                                        .gallery-grip { cursor: grab; color: var(--text-secondary); padding: 0 4px; flex-shrink: 0; }
                                        .gallery-grip:active { cursor: grabbing; }
                                        .gallery-row.dragging { opacity: 0.4; }
                                        .gallery-row.drag-over { outline: 2px dashed var(--primary-color); outline-offset: -2px; border-radius: 10px; }
                                    </style>
                                    <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>A primeira imagem adicionada será usada como miniatura principal (thumbnail).</div>
                                </div>
                            </div>

                            <!-- Planos e Prazos Card -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="bi bi-calendar-range text-primary me-2"></i>
                                        Geração Automática de Planos
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold">Prazo Mínimo (meses) *</label>
                                            <input type="number" name="minDuration" class="form-control" value="<%= product.minDuration || 12 %>" min="1" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold">Prazo Máximo (meses) *</label>
                                            <input type="number" name="maxDuration" class="form-control" value="<%= product.maxDuration || 60 %>" min="1" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold">Taxa de Adm. (%) *</label>
                                            <input type="number" step="0.01" name="adminFeeRate" class="form-control" value="<%= product.adminFeeRate || 15.0 %>" required>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <div class="alert alert-info mb-0 py-2 small w-100 text-center">
                                                Salvar o produto gerará planos anuais.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Especificações Técnicas Card -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="bi bi-gear text-primary me-2"></i>
                                        Especificações Técnicas
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <textarea name="specs" id="specsJson" class="form-control d-none"><%= product.specs || '{}' %></textarea>
                                    <div id="dynamicSpecsContainer" class="row g-3">
                                        <!-- Fields injected by JS -->
                                    </div>
                                </div>
                            </div>

                            <!-- Pré-visualização no catálogo (ao vivo) -->
                            <div class="card mb-4 shadow-sm">
                                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold">
                                        <i class="bi bi-phone text-primary me-2"></i>
                                        Pré-visualização no catálogo <small class="text-muted fw-normal">— atualiza enquanto você digita</small>
                                    </h5>
                                    <span class="badge rounded-pill" id="pvPositionBadge" style="background: rgba(99,102,241,.12); color: var(--primary-color); font-size: .8rem;">#0 no catálogo</span>
                                </div>
                                <div class="card-body">
                                    <style>
                                        /* Espelho fiel de .offer-card do app (zuvio-web/app/pages/index.vue) */
                                        .pv-phone { width: 300px; max-width: 100%; margin: 0 auto; background: #FAFAFA; border-radius: 24px; border: 8px solid #263238; overflow: hidden; }
                                        .pv-screen { padding: 12px; font-family: 'Inter', sans-serif; }
                                        .pv-offer-card { width: 100%; background: #FFFFFF; border-radius: 18px; box-shadow: 0 4px 12px rgba(0,0,0,.08); overflow: hidden; margin-bottom: 10px; }
                                        .pv-offer-image-box { position: relative; height: 135px; background: #EEEEEE; }
                                        .pv-offer-image-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
                                        .pv-offer-featured-tag { position: absolute; top: 10px; right: 10px; background: #FF6D00; color: #FFFFFF; padding: 5px 9px; border-radius: 6px; font-size: 10px; font-weight: 800; }
                                        .pv-offer-card-body { padding: 14px; }
                                        .pv-offer-name { font-size: 15px; font-weight: 800; color: #263238; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 6px; }
                                        .pv-offer-price-row { display: flex; align-items: center; justify-content: space-between; }
                                        .pv-price-label { font-size: 11px; color: #757575; display: block; }
                                        .pv-price-val { font-size: 18px; font-weight: 800; color: #FF6D00; }
                                        .pv-btn-arrow { width: 34px; height: 34px; border-radius: 8px; background: rgba(255,109,0,.12); color: #FF6D00; display: flex; align-items: center; justify-content: center; }
                                        .pv-value-card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 12px rgba(0,0,0,.08); padding: 12px; }
                                    </style>
                                    <div class="row g-4">
                                        <div class="col-md-5">
                                            <div class="info-label text-muted small mb-2 text-center">CARD NO APP</div>
                                            <div class="pv-phone">
                                                <div class="pv-screen">
                                                    <div class="pv-offer-card">
                                                        <div class="pv-offer-image-box">
                                                            <img id="pvImg" src="" alt="prévia do produto">
                                                            <span id="pvTag" class="pv-offer-featured-tag">DESTAQUE</span>
                                                        </div>
                                                        <div class="pv-offer-card-body">
                                                            <div id="pvName" class="pv-offer-name">—</div>
                                                            <div class="pv-offer-price-row">
                                                                <div>
                                                                    <span class="pv-price-label">Parcelas a partir de</span>
                                                                    <span id="pvMonthly" class="pv-price-val">—</span>
                                                                </div>
                                                                <div class="pv-btn-arrow"><i class="bi bi-arrow-right"></i></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="pv-value-card">
                                                        <div style="font-size: 11px; color: #757575;">VALOR DO CONSÓRCIO</div>
                                                        <div id="pvPrice" class="fw-bold" style="font-size: 24px; color: #263238;">—</div>
                                                        <div id="pvPlansLine" style="font-size: 12px; color: #616161;"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-7">
                                            <div class="info-label text-muted small mb-2">COMO VAI APARECER</div>
                                            <ul class="list-group list-group-flush" id="pvChecklist">
                                                <li class="list-group-item px-0 d-flex gap-2 align-items-start"><i class="bi mt-1" data-ck="img"></i><span data-ck-text="img"></span></li>
                                                <li class="list-group-item px-0 d-flex gap-2 align-items-start"><i class="bi mt-1" data-ck="price"></i><span data-ck-text="price"></span></li>
                                                <li class="list-group-item px-0 d-flex gap-2 align-items-start"><i class="bi mt-1" data-ck="section"></i><span data-ck-text="section"></span></li>
                                                <li class="list-group-item px-0 d-flex gap-2 align-items-start"><i class="bi mt-1" data-ck="active"></i><span data-ck-text="active"></span></li>
                                            </ul>
                                            <div class="alert alert-info border-0 small mt-3 mb-0" style="border-radius: 10px;">
                                                <i class="bi bi-info-circle me-1"></i>
                                                A parcela é uma estimativa (preço + taxa adm. + 2% fundo ÷ prazo máximo).
                                                O valor exato é calculado pelos planos gerados ao salvar.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Status & Save -->
                            <div class="card shadow-sm border-0 bg-light">
                                <div class="card-body d-flex justify-content-between align-items-center py-3">
                                    <div class="form-check form-switch ps-5">
                                        <input class="form-check-input fs-4 mt-1 ms-n5" type="checkbox" name="active" id="activeCheck" <%=product.active !== false ? 'checked' : '' %>>
                                        <label class="form-check-label mt-1 ms-2" for="activeCheck">
                                            <strong>Produto Ativo</strong> (Visível no App)
                                        </label>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="/admin/products" class="btn btn-outline-secondary px-4">
                                            Cancelar
                                        </a>
                                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                                            <i class="bi bi-check-lg me-2"></i>Salvar Produto
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const typeSelect = document.getElementById('typeSelect');
                const categorySelect = document.getElementById('categorySelect');
                const categoryHidden = document.getElementById('categoryHiddenInputValue');
                const specsJson = document.getElementById('specsJson');
                const specsContainer = document.getElementById('dynamicSpecsContainer');
                const imageContainer = document.getElementById('imageUrlsContainer');
                const imageUrlsHidden = document.getElementById('imageUrlsArrayHidden');
                const FALLBACK_THUMB = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96"><rect width="100%" height="100%" fill="#ECEFF1"/><text x="50%" y="54%" font-size="13" fill="#90A4AE" text-anchor="middle" font-family="sans-serif">sem foto</text></svg>');
                const mainImageHidden = document.getElementById('mainImageUrlHidden');
                const addImageButton = document.getElementById('addImageBtn');
                const form = document.getElementById('productForm');
                const csrfToken = (form.querySelector('input[name="_csrf"]') || {}).value || '';

                const categoryOptions = {
                    MOTO: [
                        ['urbana', 'Urbana'], ['esportiva', 'Esportiva'], ['trail', 'Trail'],
                        ['custom', 'Custom'], ['street', 'Street'], ['adventure', 'Adventure'],
                        ['scooter', 'Scooter'], ['naked', 'Naked'], ['touring', 'Touring']
                    ],
                    CARRO: [['suv', 'SUV'], ['hatch', 'Hatch'], ['sedan', 'Sedan'], ['pickup', 'Picape'], ['esportivo', 'Esportivo'], ['outros', 'Outros']],
                    CARTA_CREDITO: [['geral', 'Uso geral'], ['veiculo', 'Veículos'], ['imovel', 'Imóveis'], ['premium', 'Premium']],
                    ELETRONICO: [['gaming', 'Gaming'], ['notebook', 'Notebook'], ['smartphone', 'Smartphone'], ['tablet', 'Tablet'], ['outros', 'Outros']],
                    IMOVEL: [['residencial', 'Residencial'], ['comercial', 'Comercial'], ['terreno', 'Terreno'], ['rural', 'Rural']],
                    SERVICO: [['educacao', 'Educação'], ['viagem', 'Viagem'], ['saude', 'Saúde'], ['consultoria', 'Consultoria'], ['outros', 'Outros']]
                };

                const specsByType = {
                    MOTO: [['displacement', 'Cilindrada'], ['power', 'Potência'], ['torque', 'Torque'], ['transmission', 'Transmissão'], ['engineType', 'Tipo de motor'], ['frontBrake', 'Freio dianteiro'], ['rearBrake', 'Freio traseiro'], ['weight', 'Peso'], ['fuelCapacity', 'Tanque'], ['consumption', 'Consumo']],
                    CARRO: [['motor', 'Motor'], ['potencia', 'Potência'], ['cambio', 'Câmbio'], ['combustivel', 'Combustível'], ['portas', 'Portas'], ['lugares', 'Lugares'], ['portaMalas', 'Porta-malas'], ['tracao', 'Tração']],
                    CARTA_CREDITO: [['finalidade', 'Finalidade'], ['restricoes', 'Restrições']],
                    ELETRONICO: [['processador', 'Processador'], ['gpu', 'GPU'], ['ram', 'Memória RAM'], ['armazenamento', 'Armazenamento'], ['tela', 'Tela'], ['bateria', 'Bateria']],
                    IMOVEL: [['area', 'Área'], ['quartos', 'Quartos'], ['banheiros', 'Banheiros'], ['vagas', 'Vagas'], ['localizacao', 'Localização']],
                    SERVICO: [['descricao', 'Descrição do serviço'], ['cobertura', 'Cobertura'], ['duracao', 'Duração'], ['observacoes', 'Observações']]
                };

                const parseJson = (value, fallback) => {
                    try {
                        const parsed = typeof value === 'string' ? JSON.parse(value || '') : value;
                        return parsed && typeof parsed === 'object' ? parsed : fallback;
                    } catch (_) {
                        return fallback;
                    }
                };

                let specsState = parseJson(<%- JSON.stringify(product.specs || '{}') %>, {});
                let imageUrls = parseJson(<%- JSON.stringify(product.imageUrls || '[]') %>, []);
                if (!Array.isArray(imageUrls)) imageUrls = [];
                const DEV_REVIEW = <%= (typeof isDev !== 'undefined' && isDev && editing) ? 'true' : 'false' %> && <%- product.id ? 'true' : 'false' %>;
                const PRODUCT_ID = <%- JSON.stringify(product.id || null) %>;
                let verifiedUrls = parseJson(<%- JSON.stringify(product.verifiedImageUrls || '[]') %>, []);
                if (!Array.isArray(verifiedUrls)) verifiedUrls = [];
                <% if (product.imageUrl) { %>
                    if (imageUrls.length === 0) imageUrls.push(<%- JSON.stringify(product.imageUrl) %>);
                <% } %>

                const renderCategories = () => {
                    const type = typeSelect.value;
                    const options = [...(categoryOptions[type] || [])];
                    const currentValue = categoryHidden.value;
                    if (currentValue && !options.some(([value]) => value === currentValue)) {
                        options.unshift([currentValue, currentValue]);
                    }
                    categorySelect.innerHTML = '<option value="">Selecione uma categoria...</option>' + options
                        .map(([value, label]) => `<option value="${value}">${label}</option>`).join('');
                    categorySelect.value = currentValue && options.some(([value]) => value === currentValue)
                        ? currentValue
                        : (options[0]?.[0] || '');
                    categoryHidden.value = categorySelect.value;
                };

                const readRenderedSpecs = () => {
                    if (!specsContainer) return {};
                    const values = {};
                    specsContainer.querySelectorAll('[data-spec-key]').forEach((field) => {
                        const value = field.value.trim();
                        if (value) values[field.dataset.specKey] = value;
                    });
                    return values;
                };

                const renderSpecs = () => {
                    const fields = specsByType[typeSelect.value] || [];
                    if (fields.length === 0) {
                        specsContainer.innerHTML = '<div class="col-12"><div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Não há especificações técnicas específicas para este tipo.</div></div>';
                        return;
                    }
                    specsContainer.innerHTML = fields.map(([key, label]) => `
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="spec-${key}">${label}</label>
                            <input type="text" class="form-control" id="spec-${key}" data-spec-key="${key}" value="${String(specsState[key] ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;')}">
                        </div>
                    `).join('');
                };

                const renderImages = () => {
                    if (imageUrls.length === 0) {
                        imageContainer.innerHTML = '<div class="text-muted small mb-2"><i class="bi bi-images me-1"></i>Nenhuma imagem adicionada. Cole uma URL ou envie uma foto.</div>';
                    } else {
                        imageContainer.innerHTML = imageUrls.map((url, index) => `
                            <div class="input-group mb-2 align-items-center gallery-row" data-image-row="${index}" draggable="${url ? 'true' : 'false'}">
                                <span class="gallery-grip" title="Arrastar para reordenar"><i class="bi bi-grip-vertical"></i></span>
                                <img src="${String(url).replace(/&/g, '&amp;').replace(/"/g, '&quot;')}" alt="miniatura ${index + 1}" class="gallery-thumb" onerror="this.src='${FALLBACK_THUMB}'">
                                ${index === 0 ? '<span class="badge bg-primary ms-1">capa</span>' : ''}
                                ${DEV_REVIEW && verifiedUrls.includes(url) ? '<span class="badge bg-success ms-1"><i class="bi bi-check-lg me-1"></i>verificada</span>' : ''}
                                <input type="url" class="form-control image-url-input" value="${String(url).replace(/&/g, '&amp;').replace(/"/g, '&quot;')}" placeholder="https://... ou /img/...">
                                ${DEV_REVIEW && url && !verifiedUrls.includes(url) ? `<button type="button" class="btn btn-outline-success verify-image" title="Marcar foto como conferida e ir para a próxima"><i class="bi bi-patch-check"></i></button>` : ''}
                                <label class="btn btn-outline-secondary mb-0" title="Enviar foto do computador">
                                    <i class="bi bi-upload"></i><input type="file" class="d-none gallery-file" accept=".jpg,.jpeg,.png,.webp" data-row="${index}">
                                </label>
                                <button type="button" class="btn btn-outline-danger remove-image" title="Remover imagem"><i class="bi bi-trash"></i></button>
                            </div>
                        `).join('');
                    }
                    imageContainer.querySelectorAll('.verify-image').forEach((button) => {
                        button.addEventListener('click', () => verifyGalleryPhoto(button));
                    });
                    // Arrastar p/ ordenar (tipo Canva): a ordem da lista vira a ordem da galeria
                    let dragFrom = null;
                    imageContainer.querySelectorAll('.gallery-row[draggable="true"]').forEach((row) => {
                        row.addEventListener('dragstart', (e) => {
                            dragFrom = Number(row.dataset.imageRow);
                            row.classList.add('dragging');
                            e.dataTransfer.effectAllowed = 'move';
                        });
                        row.addEventListener('dragend', () => {
                            row.classList.remove('dragging');
                            imageContainer.querySelectorAll('.gallery-row').forEach(r => r.classList.remove('drag-over'));
                        });
                        row.addEventListener('dragover', (e) => {
                            e.preventDefault();
                            e.dataTransfer.dropEffect = 'move';
                            row.classList.add('drag-over');
                        });
                        row.addEventListener('dragleave', () => row.classList.remove('drag-over'));
                        row.addEventListener('drop', (e) => {
                            e.preventDefault();
                            const dragTo = Number(row.dataset.imageRow);
                            if (dragFrom === null || dragFrom === dragTo) return;
                            const [moved] = imageUrls.splice(dragFrom, 1);
                            imageUrls.splice(dragTo, 0, moved);
                            renderImages();
                        });
                    });
                    imageContainer.querySelectorAll('.remove-image').forEach((button) => {
                        button.addEventListener('click', () => {
                            const row = button.closest('[data-image-row]');
                            imageUrls.splice(Number(row.dataset.imageRow), 1);
                            renderImages();
                        });
                    });
                    imageContainer.querySelectorAll('.gallery-file').forEach((input) => {
                        input.addEventListener('change', () => uploadGalleryPhoto(input));
                    });
                };

                async function verifyGalleryPhoto(button) {
                    const row = button.closest('[data-image-row]');
                    const input = row.querySelector('.image-url-input');
                    const url = (input.value || '').trim();
                    if (!url) return;
                    button.disabled = true;
                    try {
                        const res = await fetch('/admin/products/' + PRODUCT_ID + '/verify-image', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'csrf-token': csrfToken },
                            body: JSON.stringify({ path: url, _csrf: csrfToken })
                        });
                        if (res.status === 401 || res.status === 403) {
                            alert('Sessão expirada — faça login novamente.');
                            location.href = '/admin/login';
                            return;
                        }
                        const data = await res.json();
                        if (!res.ok || !data.ok) throw new Error(data.message || 'Falha ao marcar');
                        verifiedUrls = data.verified;
                        renderImages();
                        // avança para a próxima ainda não verificada
                        const current = imageUrls.map(u => u.trim()).filter(Boolean);
                        const nextIdx = current.findIndex(u => !verifiedUrls.includes(u));
                        const nextInput = imageContainer.querySelector(`[data-image-row="${nextIdx >= 0 ? nextIdx : 0}"] .image-url-input`);
                        if (nextInput) { nextInput.focus(); nextInput.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
                    } catch (e) {
                        alert('Não foi possível marcar: ' + (e.message || e));
                    } finally {
                        button.disabled = false;
                    }
                }

                async function uploadGalleryPhoto(input) {
                    const file = input.files && input.files[0];
                    if (!file) return;
                    const row = Number(input.dataset.row);
                    const fd = new FormData();
                    fd.append('photo', file);
                    fd.append('tipo', typeSelect.value || 'MOTO');
                    fd.append('slug', (form.querySelector('[name="name"]')?.value || 'produto'));
                    fd.append('_csrf', csrfToken);
                    input.disabled = true;
                    try {
                        const res = await fetch('/admin/products/upload', { method: 'POST', headers: { 'csrf-token': csrfToken }, body: fd });
                        const data = await res.json();
                        if (!res.ok || !data.ok) throw new Error(data.message || 'Falha no envio');
                        imageUrls[row] = data.path;
                        renderImages();
                    } catch (e) {
                        alert('Não foi possível enviar: ' + (e.message || e));
                    } finally {
                        input.disabled = false;
                    }
                }

                typeSelect.addEventListener('change', () => {
                    specsState = { ...specsState, ...readRenderedSpecs() };
                    renderCategories();
                    renderSpecs();
                });
                categorySelect.addEventListener('change', () => { categoryHidden.value = categorySelect.value; });
                addImageButton.addEventListener('click', () => {
                    const currentUrls = [...imageContainer.querySelectorAll('.image-url-input')].map(input => input.value.trim()).filter(Boolean);
                    imageUrls = [...currentUrls, ''];
                    renderImages();
                    imageContainer.querySelector('.image-url-input:last-of-type')?.focus();
                });
                form.addEventListener('submit', () => {
                    specsState = { ...specsState, ...readRenderedSpecs() };
                    specsJson.value = JSON.stringify(specsState);
                    imageUrls = [...imageContainer.querySelectorAll('.image-url-input')].map(input => input.value.trim()).filter(Boolean);
                    imageUrlsHidden.value = JSON.stringify(imageUrls);
                    mainImageHidden.value = imageUrls[0] || '';
                });

                renderCategories();
                renderSpecs();
                renderImages();
                initLivePreview();

                // ── Pré-visualização ao vivo (espelha o catálogo do app) ──
                function initLivePreview() {
                    const nameInput = form.querySelector('[name="name"]');
                    const priceInput = form.querySelector('[name="price"]');
                    const brandInput = form.querySelector('[name="brand"]');
                    const orderInput = document.getElementById('displayOrderInput');
                    const featuredInput = document.getElementById('isFeaturedCheck');
                    const popularInput = document.getElementById('isPopularCheck');
                    const activeInput = document.getElementById('activeCheck');
                    const minInput = form.querySelector('[name="minDuration"]');
                    const maxInput = form.querySelector('[name="maxDuration"]');
                    const feeInput = form.querySelector('[name="adminFeeRate"]');

                    const pvImg = document.getElementById('pvImg');
                    const pvName = document.getElementById('pvName');
                    const pvPrice = document.getElementById('pvPrice');
                    const pvMonthly = document.getElementById('pvMonthly');
                    const pvPlansLine = document.getElementById('pvPlansLine');
                    const pvTag = document.getElementById('pvTag');
                    const pvBadge = document.getElementById('pvPositionBadge');
                    const FALLBACK_IMG = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="600" height="280"><rect width="100%" height="100%" fill="#ECEFF1"/><text x="50%" y="52%" font-size="28" fill="#90A4AE" text-anchor="middle" font-family="sans-serif">sem imagem</text></svg>');

                    const money = (v) => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

                    function setCheck(key, ok, okText, badText) {
                        const icon = document.querySelector('[data-ck="' + key + '"]');
                        const text = document.querySelector('[data-ck-text="' + key + '"]');
                        if (!icon || !text) return;
                        icon.className = 'bi mt-1 ' + (ok ? 'bi-check-circle-fill text-success' : 'bi-exclamation-circle text-warning');
                        text.textContent = ok ? okText : badText;
                    }

                    function update() {
                        const name = (nameInput.value || '').trim();
                        const price = parseFloat(priceInput.value) || 0;
                        const brand = (brandInput.value || '').trim();
                        const order = parseInt(orderInput.value, 10);
                        const max = parseInt(maxInput.value, 10) || 60;
                        const fee = parseFloat(feeInput.value) || 15;
                        const firstImg = [...imageContainer.querySelectorAll('.image-url-input')].map(i => i.value.trim()).filter(Boolean)[0] || '';

                        pvName.textContent = name || 'Nome do produto';
                        pvPrice.textContent = price > 0 ? money(price) : 'R$ 0,00';
                        const monthly = price > 0 ? (price * (1 + (fee + 2) / 100) / max) : 0;
                        pvMonthly.textContent = monthly > 0 ? money(monthly) : '—';
                        pvPlansLine.textContent = 'ou ' + max + 'x de ' + money(monthly) + (brand ? ' • ' + brand : '');
                        pvImg.src = firstImg || FALLBACK_IMG;
                        pvTag.style.display = featuredInput.checked ? '' : 'none';
                        pvBadge.textContent = '#' + (Number.isFinite(order) ? order : 0) + ' no catálogo';

                        setCheck('img', !!firstImg, 'Imagem principal definida — o card usa a 1ª foto da galeria.', 'Sem imagem: adicione ao menos 1 URL na Galeria de Imagens.');
                        setCheck('price', price > 0, 'Preço válido: ' + money(price) + ' → ~' + money(monthly) + '/mês no prazo máximo.', 'Informe o preço para calcular a parcela exibida no app.');
                        const sections = [];
                        if (featuredInput.checked) sections.push('Melhores Ofertas');
                        if (popularInput.checked) sections.push('Mais Populares');
                        setCheck('section', sections.length > 0, 'Aparece em: ' + sections.join(' + ') + ' (além da busca).', 'Aparece só na busca — marque Destaque e/ou Popular para ganhar seção na tela inicial.');
                        const isActive = activeInput.checked;
                        setCheck('active', isActive, 'Produto ativo: visível no catálogo do app.', 'Produto inativo: fica OCULTO no app (só visível aqui no admin).');
                    }

                    ['input', 'change'].forEach(evt => {
                        [nameInput, priceInput, brandInput, orderInput, minInput, maxInput, feeInput].forEach(el => el && el.addEventListener(evt, update));
                        [featuredInput, popularInput, activeInput, typeSelect, categorySelect].forEach(el => el && el.addEventListener('change', update));
                    });
                    // Galeria é re-renderizada via JS — observa mudanças nos inputs de imagem
                    imageContainer.addEventListener('input', update);
                    addImageButton.addEventListener('click', () => setTimeout(update, 0));
                    pvImg.onerror = () => { if (pvImg.src !== FALLBACK_IMG) pvImg.src = FALLBACK_IMG; };
                    update();
                }
            });
        </script>
