<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/contracts' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Novo Contrato de Consórcio</h1>
                    <p class="text-muted mb-0">Preencha os dados para criar um novo contrato</p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/contracts" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof error_msg !=='undefined' && error_msg && error_msg.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <div class="row g-4">
                        <!-- Form -->
                        <div class="col-md-7">
                            <div class="admin-card">
                                <div class="admin-card__header">
                                    <h5 class="mb-0">
                                        <i class="bi bi-file-text me-2" style="color: var(--admin-brand);"></i>
                                        Dados do Contrato
                                    </h5>
                                </div>
                                <div class="admin-card__body">
                                    <form action="/admin/contracts/new" method="POST" id="contractForm">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <!-- Step 1: Client Selection -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-person me-2"></i>
                                            1. Selecione o Cliente *
                                        </label>
                                        <select name="userId" class="form-select form-select-lg" required
                                            id="clientSelect">
                                            <option value="">Escolha um cliente...</option>
                                            <% clients.forEach(client=> { %>
                                                <option value="<%= client.id %>" data-name="<%= client.name %>"
                                                    data-cpf="<%= client.cpf %>" data-email="<%= client.email %>"
                                                    <%=(typeof clientId !=='undefined' && clientId &&
                                                    clientId.toString()===client.id.toString()) ? 'selected' : '' %>>
                                                    <%= client.name %> - <%=
                                                            client.cpf.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4'
                                                            ) %>
                                                </option>
                                                <% }); %>
                                        </select>
                                        <small class="text-muted">Selecione o cliente que irá contratar o
                                            consórcio</small>

                                        <div id="clientPreview" class="mt-3 p-3 rounded"
                                            style="background: var(--bg-tertiary); display: none;">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="user-avatar text-white fw-bold d-flex align-items-center justify-content-center"
                                                    style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(45deg, var(--primary-color), #2b5c8f); font-size: 1.2rem;">
                                                    <span id="clientInitial"></span>
                                                </div>
                                                <div>
                                                    <strong id="clientName" class="d-block"></strong>
                                                    <small class="text-muted d-block" id="clientCpf"></small>
                                                    <small class="text-muted" id="clientEmail"></small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <hr class="my-4">

                                    <!-- Step 2: Plan Selection -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-box-seam me-2"></i>
                                            2. Selecione o Produto e Plano *
                                        </label>
                                        
                                        <input type="hidden" name="planId" id="planId" required>

                                        <div class="row g-3">
                                            <div class="col-md-12">
                                                <label class="form-label small">Produto</label>
                                                <select id="uiProductSelect" class="form-select form-select-lg">
                                                    <option value="">Escolha um produto...</option>
                                                </select>
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <label class="form-label small">Parcelas (Meses)</label>
                                                <select id="uiDurationSelect" class="form-select form-select-lg" disabled>
                                                    <option value="">Escolha as parcelas...</option>
                                                </select>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label small">Taxa Administrativa</label>
                                                <select id="uiFeeSelect" class="form-select form-select-lg" disabled>
                                                    <option value="">Escolha a taxa...</option>
                                                </select>
                                            </div>
                                        </div>
                                        <small class="text-muted mt-2 d-block">Escolha o produto, a duração em meses e a taxa para definir o plano</small>
                                    </div>

                                    <hr class="my-4">

                                    <!-- Step 3: Group/Quota -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-hash me-2"></i>
                                            3. Números do Grupo e Cota
                                        </label>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <label class="form-label small">Número do Grupo</label>
                                                <input type="text" name="groupNumber" class="form-control"
                                                    placeholder="Ex: 001" maxlength="3" pattern="[0-9]{1,3}">
                                                <small class="text-muted">Deixe em branco para gerar
                                                    automaticamente</small>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small">Número da Cota</label>
                                                <input type="text" name="quotaNumber" class="form-control"
                                                    placeholder="Ex: 042" maxlength="3" pattern="[0-9]{1,3}">
                                                <small class="text-muted">Deixe em branco para gerar
                                                    automaticamente</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Submit Buttons -->
                                    <div class="d-flex justify-content-end gap-3 mt-4">
                                        <a href="/admin/contracts" class="btn btn-outline-secondary btn-lg">
                                            <i class="bi bi-x-lg me-2"></i>Cancelar
                                        </a>
                                        <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                                            <i class="bi bi-check-lg me-2"></i>Criar Contrato
                                        </button>
                                    </div>
                                </form>
                                </div>
                            </div>
                        </div>

                        <!-- Preview -->
                        <div class="col-md-5">
                            <div class="admin-card sticky-top" style="top: 2rem;">
                                <div class="admin-card__header">
                                    <h5 class="mb-0">
                                        <i class="bi bi-eye me-2" style="color: var(--admin-brand);"></i>
                                        Pré-visualização
                                    </h5>
                                </div>
                                <div class="admin-card__body">
                                    <div id="previewEmpty" class="text-center py-5">
                                    <i class="bi bi-file-earmark-text" style="font-size: 4rem; opacity: 0.2;"></i>
                                    <p class="text-muted mt-3">Preencha os campos ao lado<br>para ver a prévia</p>
                                </div>

                                <div id="previewContent" style="display: none;">
                                    <!-- Product Image -->
                                    <div class="mb-4" id="productImageContainer" style="display: none;">
                                        <img id="productImage" src="" alt="Produto" class="w-100 rounded"
                                            style="height: 200px; object-fit: cover;">
                                    </div>

                                    <!-- Plan Summary -->
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Produto</small>
                                        <h5 class="mb-0" id="previewProduct">-</h5>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Duração do Plano</small>
                                        <h6 class="mb-0" id="previewDuration">-</h6>
                                    </div>

                                    <hr>

                                    <!-- Financial Info -->
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Preço do Bem</small>
                                        <h5 class="mb-0" style="color: var(--primary-color);" id="previewPrice">-</h5>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Taxa Administrativa</small>
                                        <p class="mb-0" id="previewAdminFee">-</p>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1">Taxa de Fundo</small>
                                        <p class="mb-0" id="previewFundRate">-</p>
                                    </div>

                                    <hr>

                                    <div class="mb-3 p-3 rounded" style="background: var(--bg-secondary);">
                                        <small class="text-muted d-block mb-1">Valor Total do Crédito</small>
                                        <h4 class="mb-0" style="color: var(--success-color);" id="previewCreditValue">-
                                        </h4>
                                    </div>

                                    <div class="mb-3 p-3 rounded" style="background: var(--bg-secondary);">
                                        <small class="text-muted d-block mb-1">Parcela Mensal Estimada</small>
                                        <h4 class="mb-0" style="color: var(--warning-color);" id="previewInstallment">-
                                        </h4>
                                    </div>

                                    <hr>

                                    <div id="previewClientInfo" style="display: none;">
                                        <small class="text-muted d-block mb-2">Contratante</small>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="user-avatar text-white fw-bold d-flex align-items-center justify-content-center" 
                                                style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(45deg, var(--primary-color), #2b5c8f);">
                                                <span id="previewClientInitial"></span>
                                            </div>
                                            <div>
                                                <strong id="previewClientName" class="d-block small"></strong>
                                                <small class="text-muted" id="previewClientCpf"></small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Alert -->
                                    <div class="alert alert-info mt-4">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <small>
                                            Ao criar o contrato, serão geradas automaticamente
                                            <strong id="installmentCount">-</strong> parcelas com vencimento
                                            mensal no dia 10 de cada mês.
                                        </small>
                                    </div>
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
        </div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const plans = <%- JSON.stringify(plans || []).replace(/</g, '\\u003c') %>;
        const clientSelect = document.getElementById('clientSelect');
        const productSelect = document.getElementById('uiProductSelect');
        const durationSelect = document.getElementById('uiDurationSelect');
        const feeSelect = document.getElementById('uiFeeSelect');
        const planIdInput = document.getElementById('planId');
        const submitButton = document.getElementById('submitBtn');
        const clientPreview = document.getElementById('clientPreview');
        const previewContent = document.getElementById('previewContent');
        const previewEmpty = document.getElementById('previewEmpty');

        const currency = (value) => Number(value || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        const unique = (items) => [...new Set(items)];
        const selectedPlan = () => plans.find((plan) => String(plan.id) === String(planIdInput.value));
        const productPlans = () => plans.filter((plan) => String(plan.productId) === String(productSelect.value));

        function setOptions(select, options, placeholder) {
            select.innerHTML = `<option value="">${placeholder}</option>`;
            options.forEach((option) => select.appendChild(option));
        }

        function populateProducts() {
            const products = [];
            const seen = new Set();
            plans.forEach((plan) => {
                if (plan.product && !seen.has(plan.product.id)) {
                    seen.add(plan.product.id);
                    products.push(plan.product);
                }
            });
            setOptions(productSelect, products.map((product) => {
                const option = document.createElement('option');
                option.value = product.id;
                option.textContent = product.name;
                return option;
            }), 'Escolha um produto...');
            productSelect.disabled = products.length === 0;
        }

        function populateDurations() {
            const currentPlans = productPlans();
            const durations = unique(currentPlans.map((plan) => plan.durationMonths)).sort((a, b) => a - b);
            setOptions(durationSelect, durations.map((duration) => {
                const option = document.createElement('option');
                option.value = duration;
                option.textContent = `${duration} meses`;
                return option;
            }), 'Escolha as parcelas...');
            durationSelect.disabled = durations.length === 0;
            setOptions(feeSelect, [], 'Escolha a taxa...');
            feeSelect.disabled = true;
            planIdInput.value = '';
        }

        function populateFees() {
            const currentPlans = productPlans().filter((plan) => String(plan.durationMonths) === String(durationSelect.value));
            const fees = unique(currentPlans.map((plan) => String(plan.adminFeeRate)));
            setOptions(feeSelect, fees.map((fee) => {
                const option = document.createElement('option');
                option.value = fee;
                option.textContent = `${Number(fee).toLocaleString('pt-BR')}%`;
                return option;
            }), 'Escolha a taxa...');
            feeSelect.disabled = fees.length === 0;
            planIdInput.value = '';
        }

        function updatePlan() {
            const plan = productPlans().find((candidate) =>
                String(candidate.durationMonths) === String(durationSelect.value) &&
                String(candidate.adminFeeRate) === String(feeSelect.value)
            );
            planIdInput.value = plan ? plan.id : '';
            updatePreview();
            submitButton.disabled = !clientSelect.value || !planIdInput.value;
        }

        function updateClientPreview() {
            const selected = clientSelect.options[clientSelect.selectedIndex];
            if (!clientSelect.value || !selected || !selected.dataset.name) {
                clientPreview.style.display = 'none';
                document.getElementById('previewClientInfo').style.display = 'none';
                return;
            }
            const name = selected.dataset.name;
            const initial = name.trim().charAt(0).toUpperCase();
            document.getElementById('clientInitial').textContent = initial;
            document.getElementById('clientName').textContent = name;
            document.getElementById('clientCpf').textContent = selected.dataset.cpf || 'CPF não informado';
            document.getElementById('clientEmail').textContent = selected.dataset.email || 'E-mail não informado';
            clientPreview.style.display = 'block';
            document.getElementById('previewClientInitial').textContent = initial;
            document.getElementById('previewClientName').textContent = name;
            document.getElementById('previewClientCpf').textContent = selected.dataset.cpf || 'CPF não informado';
            document.getElementById('previewClientInfo').style.display = 'block';
            submitButton.disabled = !planIdInput.value;
        }

        function updatePreview() {
            const plan = selectedPlan();
            if (!plan) {
                previewContent.style.display = 'none';
                previewEmpty.style.display = 'block';
                return;
            }
            previewEmpty.style.display = 'none';
            previewContent.style.display = 'block';
            document.getElementById('previewProduct').textContent = plan.product?.name || 'Produto';
            document.getElementById('previewDuration').textContent = `${plan.durationMonths} meses`;
            document.getElementById('previewPrice').textContent = currency(plan.product?.price);
            document.getElementById('previewAdminFee').textContent = `${Number(plan.adminFeeRate).toLocaleString('pt-BR')}%`;
            document.getElementById('previewFundRate').textContent = `${Number(plan.fundRate).toLocaleString('pt-BR')}%`;
            const credit = Number(plan.product?.price || 0) * (1 + Number(plan.adminFeeRate || 0) / 100 + Number(plan.fundRate || 0) / 100);
            document.getElementById('previewCreditValue').textContent = currency(credit);
            document.getElementById('previewInstallment').textContent = currency(credit / Number(plan.durationMonths || 1));
            document.getElementById('installmentCount').textContent = plan.durationMonths;
            if (plan.product?.imageUrl) {
                document.getElementById('productImage').src = plan.product.imageUrl;
                document.getElementById('productImageContainer').style.display = 'block';
            }
        }

        clientSelect.addEventListener('change', updateClientPreview);
        productSelect.addEventListener('change', function () {
            populateDurations();
            updatePreview();
            submitButton.disabled = true;
        });
        durationSelect.addEventListener('change', function () {
            populateFees();
            updatePlan();
        });
        feeSelect.addEventListener('change', updatePlan);

        populateProducts();
        updateClientPreview();
        updatePreview();
        submitButton.disabled = true;
    });
</script>

<%- include('../../partials/footer') %>
