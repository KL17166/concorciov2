<%- include('../partials/header') %>

    <%- include('../partials/sidebar', { path: '/dashboard' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Dashboard</h1>
                    <p class="text-muted mb-0">Visão geral do sistema</p>
                </div>
                <div class="top-bar-actions">
                    <% if (user) { %>
                        <div class="user-info">
                            <div class="user-avatar"
                                style="width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.9rem;">
                                    <%= user.name %>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrador</div>
                            </div>
                        </div>
                    <% } %>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Stats Cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Total Clientes</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: var(--primary-color);"><%= stats.totalUsers %></div>
                                <small class="text-muted mt-2 d-block">Cadastrados no sistema</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color);">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Contratos Ativos</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #10b981;"><%= stats.activeContracts %></div>
                                <small class="text-muted mt-2 d-block">Em andamento</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-file-check-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Adesões Aguardando</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #f59e0b;"><%= stats.pendingAdesoes %></div>
                                <small class="text-muted mt-2 d-block"><a href="/admin/payments?status=ADESOES" class="text-decoration-none">Cobrar no Financeiro →</a></small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-person-plus-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Atendimentos Abertos</div>
                                <div style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #ef4444;"><%= stats.openTickets %></div>
                                <small class="text-muted mt-2 d-block"><a href="/admin/tickets" class="text-decoration-none">Ver atendimentos →</a></small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                <i class="bi bi-headset"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Secondary Stats -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">KYC em Análise</div>
                                <div style="font-size: 1.8rem; font-weight: 800; line-height: 1; color: #f59e0b;">
                                    <%= stats.kycPending %>
                                </div>
                                <small class="text-muted mt-2 d-block"><a href="/admin/kyc" class="text-decoration-none">Revisar documentos →</a></small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-person-check"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Total Contratos</div>
                                <div style="font-size: 1.8rem; font-weight: 800; line-height: 1; color: #3b82f6;"><%= stats.totalContracts %></div>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                                <i class="bi bi-files"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Contemplados</div>
                                <div style="font-size: 1.8rem; font-weight: 800; line-height: 1; color: #8b5cf6;"><%= stats.contemplatedContracts %></div>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                <i class="bi bi-award-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Learning Row: algoritmo aprendendo com o pixel -->
            <% if (typeof learning !== 'undefined' && learning) { %>
            <div class="row g-4 mb-5">
                <div class="col-md-7">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="info-label">Funil do app — últimos 7 dias (<%= learning.totalEvents7d %> eventos)</div>
                                <div style="font-size: 1.1rem; font-weight: 800;">Telas → "Já paguei": <%= learning.conversion %>%</div>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                <i class="bi bi-crosshair"></i>
                            </div>
                        </div>
                        <% const maxFunnel = Math.max(1, ...learning.funnel.map(f => f.count)); %>
                        <% learning.funnel.forEach(function(f) { %>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <code style="width: 190px; font-size: 0.72rem;"><%= f.event %></code>
                                <div class="progress flex-grow-1" style="height: 8px; border-radius: 6px;">
                                    <div class="progress-bar" role="progressbar" style="width: <%= Math.round((f.count / maxFunnel) * 100) %>%;"></div>
                                </div>
                                <strong style="width: 60px; text-align: right;"><%= f.count %></strong>
                            </div>
                        <% }); %>
                        <small class="text-muted d-block mt-2">QR→verifica: <%= learning.convQrVerify %>% · verifica→pago: <%= learning.convVerifyPaid %>% · <a href="/admin/tracking" class="text-decoration-none">Abrir Tracking →</a></small>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="premium-stat-card p-4">
                        <div class="info-label">Produtos em alta (interesse real, 30d)</div>
                        <% if (learning.topProducts && learning.topProducts.length > 0) { %>
                            <% learning.topProducts.forEach(function(p, i) { %>
                                <div class="d-flex justify-content-between align-items-center py-1 <%= i < learning.topProducts.length - 1 ? 'border-bottom' : '' %>">
                                    <span><%= p.name %></span>
                                    <span class="badge bg-primary rounded-pill"><%= p.hits %></span>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-muted mb-0">Sem sinais ainda — o ranking usa a ordem do admin até o pixel treinar.</p>
                        <% } %>
                        <small class="text-muted d-block mt-2"><%= learning.weightCount %> pesos aprendidos · o catálogo do app já reordena sozinho.</small>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Charts Row -->
            <div class="row g-4 mb-5">
                <div class="col-md-8">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>
                                Contratos por Mês
                            </div>
                        </div>
                        <div class="px-4 pt-3 pb-3" style="position: relative; height: 320px; width: 100%;">
                            <canvas id="contractsMonthChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium">
                            <i class="bi bi-pie-chart-fill me-2 text-warning"></i>
                            Contratos por Status
                        </div>
                        <div class="p-4 d-flex justify-content-center align-items-center" style="position: relative; height: 320px; width: 100%;">
                            <canvas id="contractsStatusChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="premium-info-card">
                        <div class="card-header-premium">
                            <i class="bi bi-file-earmark-text me-2 text-primary"></i>
                            Contratos Recentes
                        </div>
                        <div class="p-0">
                            <% if (recentContracts && recentContracts.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-custom align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Cliente</th>
                                                <th>Produto</th>
                                                <th>Status</th>
                                                <th>Data</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% recentContracts.forEach(contract => { %>
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; margin-right: 0.75rem;">
                                                                <%= contract.user.name.charAt(0).toUpperCase() %>
                                                            </div>
                                                            <strong style="font-size: 0.9rem;"><%= contract.user.name %></strong>
                                                        </div>
                                                    </td>
                                                    <td><small class="text-muted"><%= contract.plan.product.name %></small></td>
                                                    <td>
                                                        <% if (contract.status === 'ACTIVE') { %>
                                                            <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);"><i class="bi bi-check-circle-fill"></i>Ativo</span>
                                                        <% } else if (contract.status === 'PENDING') { %>
                                                            <span class="badge-premium" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2);"><i class="bi bi-clock-fill"></i>Pendente</span>
                                                        <% } else if (contract.status === 'CONTEMPLATED') { %>
                                                            <span class="badge-premium" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.2);"><i class="bi bi-trophy-fill"></i>Contemplado</span>
                                                        <% } else if (contract.status === 'CANCELLED') { %>
                                                            <span class="badge-premium" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);"><i class="bi bi-x-circle-fill"></i>Cancelado</span>
                                                        <% } else if (contract.status === 'PENDING_KYC') { %>
                                                            <span class="badge-premium" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2);"><i class="bi bi-person-check-fill"></i>Aguardando KYC</span>
                                                        <% } else if (contract.status === 'COMPLETED') { %>
                                                            <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);"><i class="bi bi-check-all"></i>Concluído</span>
                                                        <% } else { %>
                                                            <span class="badge-premium" style="background: rgba(108, 117, 125, 0.1); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.2);"><%= contract.status %></span>
                                                        <% } %>
                                                    </td>
                                                    <td><small class="text-muted"><%= new Date(contract.createdAt).toLocaleDateString('pt-BR') %></small></td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5">
                                    <i class="bi bi-file-earmark-text text-muted" style="font-size: 2.5rem; opacity: 0.3;"></i>
                                    <p class="text-muted mt-2 mb-0">Nenhum contrato recente</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="premium-info-card">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-headset me-2 text-danger"></i>
                                Atendimentos Recentes
                            </div>
                            <a href="/admin/tickets" class="btn btn-sm btn-outline-primary" style="border-radius: 8px;">Ver todos</a>
                        </div>
                        <div class="p-0">
                            <% if (recentTickets && recentTickets.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-custom align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Cliente</th>
                                                <th>Assunto</th>
                                                <th>Status</th>
                                                <th>Data</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% recentTickets.forEach(ticket => { %>
                                                <tr>
                                                    <td>
                                                        <strong style="font-size: 0.9rem;"><%= ticket.user ? ticket.user.name : '—' %></strong>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted"><%= ticket.subject %></small>
                                                    </td>
                                                    <td>
                                                        <% if (ticket.status === 'OPEN') { %>
                                                            <span class="badge-premium" style="background:rgba(239,68,68,0.1); color:#ef4444; border:1px solid rgba(239,68,68,0.2);">Aberto</span>
                                                        <% } else if (ticket.status === 'IN_PROGRESS') { %>
                                                            <span class="badge-premium" style="background:rgba(245,158,11,0.1); color:#f59e0b; border:1px solid rgba(245,158,11,0.2);">Em atendimento</span>
                                                        <% } else { %>
                                                            <span class="badge-premium" style="background:rgba(16,185,129,0.1); color:#10b981; border:1px solid rgba(16,185,129,0.2);">Encerrado</span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">
                                                            <%= ticket.createdAt ? new Date(ticket.createdAt).toLocaleDateString('pt-BR') : '-' %>
                                                        </small>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5">
                                    <i class="bi bi-headset text-muted" style="font-size: 2.5rem; opacity: 0.3;"></i>
                                    <p class="text-muted mt-2 mb-0">Nenhum atendimento recente</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mb-5"></div>
        </div>

        <script>
            // Parse data from server safely
            const contractsByMonth = JSON.parse('<%- JSON.stringify(contractsByMonth || []) %>');
            const contractsByStatus = JSON.parse('<%- JSON.stringify(contractsByStatus || {}) %>');

            // 1. Contracts by Status (Doughnut)
            const ctxStatus = document.getElementById('contractsStatusChart')?.getContext('2d');
            if (ctxStatus) {
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: ['Em adesão', 'Ativos', 'Contemplados', 'Cancelados', 'Concluídos'],
                        datasets: [{
                            data: [
                                contractsByStatus.pending || 0,
                                contractsByStatus.active || 0,
                                contractsByStatus.contemplated || 0,
                                contractsByStatus.cancelled || 0,
                                contractsByStatus.completed || 0
                            ],
                            backgroundColor: [
                                '#f59e0b', // yellow
                                '#10b981', // green
                                '#8b5cf6', // purple
                                '#ef4444', // red
                                '#3b82f6'  // blue
                            ],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true,
                                    font: { family: "'Inter', sans-serif", size: 12 }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Contracts by Month (Bar)
            const ctxMonth = document.getElementById('contractsMonthChart')?.getContext('2d');
            if (ctxMonth) {
                new Chart(ctxMonth, {
                    type: 'bar',
                    data: {
                        labels: contractsByMonth.map(d => d.label),
                        datasets: [{
                            label: 'Contratos',
                            data: contractsByMonth.map(d => d.total),
                            backgroundColor: 'rgba(99, 102, 241, 0.7)',
                            borderColor: '#6366f1',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                border: { display: false },
                                grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                ticks: {
                                    maxTicksLimit: 6,
                                    precision: 0
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

        </script>

<%- include('../partials/footer') %>
