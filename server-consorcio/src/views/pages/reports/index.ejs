<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/reports' }) %>

        <div class="main-content reports-page">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Relatórios & Inteligência</h1>
                    <p class="text-muted mb-0">Visão consolidada de faturamento, contratos e saúde financeira</p>
                </div>
                <div class="top-bar-actions">
                    <button class="btn btn-sm btn-outline-success" onclick="exportReport()">
                        <i class="bi bi-file-earmark-excel me-1"></i> Exportar CSV
                    </button>
                    <button class="theme-toggle" onclick="toggleTheme()" aria-label="Alternar tema">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Period Filter Bar -->
            <div class="premium-info-card mb-4 p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: var(--primary-color); font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                            <i class="bi bi-calendar3 me-1"></i> Período
                        </span>
                        <span class="text-muted small">Filtrar métricas por intervalo de datas</span>
                    </div>
                    <form method="GET" action="/admin/reports" class="d-flex align-items-center gap-2 flex-wrap m-0">
                        <div class="btn-group shadow-sm" role="group">
                            <a href="/admin/reports?period=today"   class="btn btn-sm <%= period === 'today'   ? 'btn-primary' : 'btn-outline-secondary' %>">Hoje</a>
                            <a href="/admin/reports?period=week"    class="btn btn-sm <%= period === 'week'    ? 'btn-primary' : 'btn-outline-secondary' %>">7 dias</a>
                            <a href="/admin/reports?period=month"   class="btn btn-sm <%= period === 'month'   ? 'btn-primary' : 'btn-outline-secondary' %>">Mês Atual</a>
                            <a href="/admin/reports?period=3months" class="btn btn-sm <%= period === '3months' ? 'btn-primary' : 'btn-outline-secondary' %>">3 Meses</a>
                            <a href="/admin/reports?period=year"    class="btn btn-sm <%= period === 'year'    ? 'btn-primary' : 'btn-outline-secondary' %>">Ano</a>
                        </div>
                        <div class="d-flex align-items-center gap-1 ms-2">
                            <input type="date" name="start" class="form-control form-control-sm" value="<%= customStart %>" style="width: 140px; border-radius: 8px;">
                            <span class="text-muted small px-1">até</span>
                            <input type="date" name="end"   class="form-control form-control-sm" value="<%= customEnd %>"   style="width: 140px; border-radius: 8px;">
                            <input type="hidden" name="period" value="custom">
                            <button type="submit" class="btn btn-sm btn-primary px-3" style="border-radius: 8px;">
                                <i class="bi bi-filter"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- SECTION 1 — Executive Hero KPI Cards                        -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="row g-4 mb-4">
                <!-- Recebido no Período -->
                <div class="col-xl-3 col-md-6">
                    <div class="premium-stat-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="info-label">Receita no Período</div>
                            <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                                <i class="bi bi-wallet2"></i>
                            </div>
                        </div>
                        <div class="fw-bold mb-1" style="font-size: 1.8rem; color: #10b981;">
                            <span style="font-size: 1.1rem;">R$</span> <%= period_stats.periodReceived.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <% if (period_stats.receivedChange !== null) { %>
                                <span class="badge" <%- `style="background: ${period_stats.receivedChange >= 0 ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)'}; color: ${period_stats.receivedChange >= 0 ? '#10b981' : '#ef4444'}; font-size: 0.75rem;"` %>>
                                    <i class="bi bi-<%= period_stats.receivedChange >= 0 ? 'arrow-up' : 'arrow-down' %>"></i>
                                    <%= Math.abs(period_stats.receivedChange).toFixed(1) %>% vs anterior
                                </span>
                            <% } else { %>
                                <small class="text-muted"><%= period_stats.paidCount %> parcela(s) liquidada(s)</small>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Ticket Médio -->
                <div class="col-xl-3 col-md-6">
                    <div class="premium-stat-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="info-label">Ticket Médio / Parcela</div>
                            <div class="stat-icon-wrapper" style="background: rgba(99, 102, 241, 0.12); color: var(--primary-color);">
                                <i class="bi bi-tag-fill"></i>
                            </div>
                        </div>
                        <div class="fw-bold mb-1" style="font-size: 1.8rem; color: var(--primary-color);">
                            <span style="font-size: 1.1rem;">R$</span> <%= period_stats.avgTicket.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </div>
                        <small class="text-muted mt-2 d-block">Média por pagamento no período</small>
                    </div>
                </div>

                <!-- Taxa de Inadimplência -->
                <div class="col-xl-3 col-md-6">
                    <div class="premium-stat-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="info-label">Taxa de Inadimplência</div>
                            <div class="stat-icon-wrapper" <%- `style="background: ${period_stats.defaultRate > 10 ? 'rgba(239, 68, 68, 0.12)' : 'rgba(245, 158, 11, 0.12)'}; color: ${period_stats.defaultRate > 10 ? '#ef4444' : '#f59e0b'};"` %>>
                                <i class="bi bi-shield-exclamation"></i>
                            </div>
                        </div>
                        <div class="fw-bold mb-1" <%- `style="font-size: 1.8rem; color: ${period_stats.defaultRate > 10 ? '#ef4444' : (period_stats.defaultRate > 0 ? '#f59e0b' : '#10b981')};"` %>>
                            <%= period_stats.defaultRate.toFixed(1) %>%
                        </div>
                        <small class="text-muted mt-2 d-block"><%= period_stats.overdueCount %> parcela(s) vencida(s) no período</small>
                    </div>
                </div>

                <!-- Total em Carteira -->
                <div class="col-xl-3 col-md-6">
                    <div class="premium-stat-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="info-label">Recebimento Acumulado</div>
                            <div class="stat-icon-wrapper" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6;">
                                <i class="bi bi-piggy-bank-fill"></i>
                            </div>
                        </div>
                        <div class="fw-bold mb-1" style="font-size: 1.8rem; color: #3b82f6;">
                            <span style="font-size: 1.1rem;">R$</span> <%= stats.totalReceived.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </div>
                        <small class="text-muted mt-2 d-block"><%= stats.activeContracts %> contratos ativos na base</small>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- SECTION 2 — Charts & Distribution (8 + 4)                   -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="row g-4 mb-4">
                <!-- Monthly Revenue Chart -->
                <div class="col-lg-8">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-graph-up-arrow me-2 text-primary"></i>
                                <strong>Evolução de Receita (Últimos 12 meses)</strong>
                            </div>
                            <span class="badge" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color);">Faturamento Mensal</span>
                        </div>
                        <div class="p-4">
                            <div id="chartRevenueData"
                                data-labels="<%= JSON.stringify(monthlyRevenue.map(m => m.month)) %>"
                                data-values="<%= JSON.stringify(monthlyRevenue.map(m => m.amount)) %>"
                                style="display:none;"></div>
                            <div style="position: relative; height: 300px; width: 100%;">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Distribution -->
                <div class="col-lg-4">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-pie-chart-fill me-2 text-warning"></i>
                                <strong>Distribuição de Parcelas</strong>
                            </div>
                            <span class="badge bg-secondary text-white" style="font-size: 0.7rem;"><%= stats.paidCount + stats.overdueCount %> Total</span>
                        </div>
                        <div class="p-4 d-flex flex-column justify-content-between">
                            <div id="chartStatusData"
                                data-labels="<%= JSON.stringify(statusDistribution.map(s => s.label)) %>"
                                data-values="<%= JSON.stringify(statusDistribution.map(s => s.value)) %>"
                                data-colors="<%= JSON.stringify(statusDistribution.map(s => s.color)) %>"
                                style="display:none;"></div>
                            <div style="position: relative; height: 180px; width: 100%;">
                                <canvas id="statusChart"></canvas>
                            </div>
                            <div class="row g-2 mt-3 pt-3 border-top border-secondary border-opacity-10">
                                <% statusDistribution.forEach(s => { %>
                                <div class="col-6">
                                    <div class="d-flex align-items-center gap-2 p-2 rounded-2" style="background: var(--bg-secondary);">
                                        <div <%- `style="width: 10px; height: 10px; border-radius: 50%; background: ${s.color}; flex-shrink: 0;"` %>></div>
                                        <div class="overflow-hidden">
                                            <div class="text-muted small text-truncate"><%= s.label %></div>
                                            <div class="fw-bold" style="font-size: 0.9rem;"><%= s.value %></div>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- SECTION 3 — Intelligence Grid (3 x 4 cols)                  -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="row g-4 mb-4">
                <!-- 1. Top Clients -->
                <div class="col-lg-4">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-trophy-fill me-2 text-warning"></i>
                                <strong>Top Clientes no Período</strong>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary small">Rank</span>
                        </div>
                        <div class="p-3">
                            <% if (topClients && topClients.length > 0) { %>
                                <div class="d-flex flex-column gap-2">
                                    <% topClients.slice(0, 5).forEach((c, idx) => { %>
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                                <div <%- `style="width: 28px; height: 28px; border-radius: 8px; background: ${idx === 0 ? 'linear-gradient(135deg, #f59e0b, #d97706)' : idx === 1 ? 'linear-gradient(135deg, #94a3b8, #64748b)' : idx === 2 ? 'linear-gradient(135deg, #b45309, #78350f)' : 'var(--bg-primary)'}; color: white; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0;"` %>>
                                                    <%= idx + 1 %>
                                                </div>
                                                <div class="overflow-hidden">
                                                    <div class="fw-semibold text-truncate" style="font-size: 0.88rem;"><%= c.name %></div>
                                                    <small class="text-muted" style="font-size: 0.72rem;"><%= c.count %> parcela(s) pagas</small>
                                                </div>
                                            </div>
                                            <div class="fw-bold text-nowrap ms-2" style="color: #10b981; font-size: 0.9rem;">
                                                R$ <%= c.total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-people text-muted" style="font-size: 2rem; opacity: 0.4;"></i>
                                    <p class="small mt-2 mb-0">Nenhum pagamento registrado no período</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- 2. Top Products & Revenue Mix -->
                <div class="col-lg-4">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-box-seam-fill me-2 text-primary"></i>
                                <strong>Top Produtos por Receita</strong>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary small">Mix</span>
                        </div>
                        <div class="p-3">
                            <% if (topProducts && topProducts.length > 0) { %>
                                <% const maxProdRev = topProducts[0].revenue || 1; %>
                                <div class="d-flex flex-column gap-3">
                                    <% topProducts.slice(0, 5).forEach(p => { %>
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small fw-semibold text-truncate" style="max-width: 60%;"><%= p.name %></span>
                                                <strong class="small" style="color: var(--primary-color);">R$ <%= p.revenue.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                                            </div>
                                            <div class="progress" style="height: 6px; border-radius: 4px; background: var(--bg-secondary);">
                                                <div class="progress-bar" <%- `style="width: ${((p.revenue / maxProdRev) * 100).toFixed(1)}%; background: linear-gradient(90deg, var(--primary-color), #8b5cf6); border-radius: 4px;"` %>></div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam text-muted" style="font-size: 2rem; opacity: 0.4;"></i>
                                    <p class="small mt-2 mb-0">Sem movimentação de produtos no período</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- 3. Health & Projections -->
                <div class="col-lg-4">
                    <div class="premium-info-card h-100">
                        <div class="card-header-premium d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-shield-check me-2 text-success"></i>
                                <strong>Saúde & Projeções</strong>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success small">Futuro</span>
                        </div>
                        <div class="p-3 d-flex flex-column gap-2">
                            <!-- Inadimplência Check -->
                            <% if (overdueClients && overdueClients.length > 0) { %>
                                <div class="p-2 rounded-3 mb-2" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2);">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-exclamation-octagon-fill text-danger"></i>
                                        <span class="small fw-bold text-danger"><%= overdueClients.length %> cliente(s) com atraso > 30 dias</span>
                                    </div>
                                    <small class="text-muted d-block">Total em atraso crítico: R$ <%= overdueClients.reduce((s, c) => s + c.total, 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></small>
                                </div>
                            <% } else { %>
                                <div class="d-flex align-items-center gap-2 p-2 rounded-3 mb-2" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2);">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 1.2rem;"></i>
                                    <div>
                                        <div class="small fw-bold text-success">Carteira 100% Adimplente</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">Nenhum cliente com atraso superior a 30 dias.</small>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Projeção 30d -->
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2" style="background: var(--bg-secondary);">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar-event text-success"></i>
                                    <span class="small">Previsão 30 dias</span>
                                </div>
                                <strong class="small" style="color: #10b981;">R$ <%= projections.proj30.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></strong>
                            </div>

                            <!-- Projeção 60d -->
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2" style="background: var(--bg-secondary);">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar-week text-warning"></i>
                                    <span class="small">Previsão 60 dias</span>
                                </div>
                                <strong class="small" style="color: #f59e0b;">R$ <%= projections.proj60.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></strong>
                            </div>

                            <!-- Projeção 90d -->
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2" style="background: var(--bg-secondary);">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar3 text-primary"></i>
                                    <span class="small">Previsão 90 dias</span>
                                </div>
                                <strong class="small" style="color: var(--primary-color);">R$ <%= projections.proj90.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- SECTION 4 — Transaction Feed (Clean Table)                   -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="premium-info-card mb-4">
                <div class="card-header-premium d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-arrow-down-circle-fill me-2 text-success"></i>
                        <strong>Pagamentos Recebidos no Período</strong>
                    </div>
                    <span class="badge bg-success bg-opacity-15 text-success" style="font-size: 0.78rem;">
                        <%= transactionFeed.length %> transações
                    </span>
                </div>
                <% if (transactionFeed && transactionFeed.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-custom align-middle w-100 mb-0" id="transactionTable">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Produto / Plano</th>
                                    <th>Parcela</th>
                                    <th>Valor</th>
                                    <th>Método</th>
                                    <th>Data de Liquidação</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% transactionFeed.forEach(t => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; flex-shrink: 0;">
                                                    <%= t.clientName.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold" style="font-size: 0.88rem;"><%= t.clientName %></div>
                                                    <div class="text-muted small" style="font-size: 0.72rem;"><%= t.clientEmail %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="small"><%= t.productName %></span></td>
                                        <td>
                                            <span class="badge" style="background: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border-color); font-size: 0.75rem;">
                                                #<%= t.installment %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="color: #10b981; font-size: 0.9rem;">
                                                R$ <%= t.amount.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </strong>
                                        </td>
                                        <td>
                                            <span class="badge-premium" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color); border: 1px solid rgba(99, 102, 241, 0.2); font-size: 0.72rem;">
                                                <%= t.paymentMethod %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-muted small">
                                                <%= t.paymentDate ? new Date(t.paymentDate).toLocaleDateString('pt-BR') : '-' %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 2.5rem; opacity: 0.3;"></i>
                        <p class="text-muted mt-3 mb-0">Nenhum pagamento liquidado no período selecionado.</p>
                    </div>
                <% } %>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- SECTION 5 — Global System Summary Grid                      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="premium-info-card mb-5">
                <div class="card-header-premium">
                    <i class="bi bi-grid-fill me-2 text-warning"></i>
                    <strong>Resumo Geral da Operação</strong>
                </div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-lg-2 col-md-4 col-6">
                            <div class="p-3 rounded-3 text-center" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                <div class="info-label mb-1">Contratos Ativos</div>
                                <div class="fw-bold fs-5" style="color: #10b981;"><%= stats.activeContracts %> / <%= stats.totalContracts %></div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <div class="p-3 rounded-3 text-center" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                <div class="info-label mb-1">Contemplados</div>
                                <div class="fw-bold fs-5" style="color: var(--primary-color);"><%= stats.contemplatedContracts %></div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <div class="p-3 rounded-3 text-center" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                <div class="info-label mb-1">Parcelas Pagas</div>
                                <div class="fw-bold fs-5" style="color: #10b981;"><%= stats.paidCount %></div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <div class="p-3 rounded-3 text-center" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                <div class="info-label mb-1">Parcelas em Atraso</div>
                                <div class="fw-bold fs-5" style="color: #ef4444;"><%= stats.overdueCount %></div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <div class="p-3 rounded-3 text-center" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                <div class="info-label mb-1">Produtos Ativos</div>
                                <div class="fw-bold fs-5 text-light"><%= stats.totalProducts %></div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <div class="p-3 rounded-3 text-center" style="background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.03);">
                                <div class="info-label mb-1">Lances Pendentes</div>
                                <div class="fw-bold fs-5" style="color: #f59e0b;"><%= stats.pendingBids %> / <%= stats.totalBids %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- .main-content -->

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark'
                || document.body.classList.contains('dark-mode')
                || true; // Default dark dashboard palette

            const gridColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';
            const textColor = isDark ? '#94a3b8' : '#64748b';

            // ── 1. Revenue chart (Smooth Area Chart) ───────────────────────
            const revEl = document.getElementById('chartRevenueData');
            const revCtx = document.getElementById('revenueChart')?.getContext('2d');
            if (revEl && revCtx) {
                const labels = JSON.parse(revEl.dataset.labels || '[]');
                const values = JSON.parse(revEl.dataset.values || '[]');

                const gradient = revCtx.createLinearGradient(0, 0, 0, 280);
                gradient.addColorStop(0, 'rgba(99, 102, 241, 0.35)');
                gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

                new Chart(revCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Faturamento',
                            data: values,
                            borderColor: '#6366f1',
                            borderWidth: 2.5,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#1e1e2d',
                            pointBorderColor: '#6366f1',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(ctx) {
                                        return ' Receita: R$ ' + Number(ctx.parsed.y).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                ticks: { color: textColor, font: { size: 11 } },
                                grid: { display: false }
                            },
                            y: {
                                beginAtZero: true,
                                border: { display: false },
                                ticks: {
                                    color: textColor,
                                    maxTicksLimit: 6,
                                    callback: v => 'R$ ' + Number(v).toLocaleString('pt-BR')
                                },
                                grid: { color: gridColor }
                            }
                        }
                    }
                });
            }

            // ── 2. Status Donut Chart ──────────────────────────────────────
            const stEl = document.getElementById('chartStatusData');
            const stCtx = document.getElementById('statusChart')?.getContext('2d');
            if (stEl && stCtx) {
                new Chart(stCtx, {
                    type: 'doughnut',
                    data: {
                        labels: JSON.parse(stEl.dataset.labels || '[]'),
                        datasets: [{
                            data: JSON.parse(stEl.dataset.values || '[]'),
                            backgroundColor: JSON.parse(stEl.dataset.colors || '[]'),
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });

        // ── Export CSV ───────────────────────────────────────────────────
        function exportReport() {
            const table = document.getElementById('transactionTable');
            if (!table) return alert('Sem transações para exportar');
            let csv = '';
            table.querySelectorAll('tr').forEach(row => {
                const cols = [...row.querySelectorAll('th,td')].map(c => '"' + c.innerText.replace(/"/g,'""').trim() + '"');
                csv += cols.join(';') + '\n';
            });
            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'relatorio_katari_' + new Date().toISOString().split('T')[0] + '.csv';
            a.click();
        }
        </script>

