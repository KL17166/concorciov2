<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/tracking' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Tracking — Analytics do App</h1>
                    <p class="text-muted mb-0">Pixel próprio: rastreamento completo do funil de conversão</p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/tracking?days=7" class="btn btn-sm <%= days === 7 ? 'btn-primary' : 'btn-outline-secondary' %>">7d</a>
                    <a href="/admin/tracking?days=30" class="btn btn-sm <%= days === 30 ? 'btn-primary' : 'btn-outline-secondary' %>">30d</a>
                    <a href="/admin/tracking?days=90" class="btn btn-sm <%= days === 90 ? 'btn-primary' : 'btn-outline-secondary' %>">90d</a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-body text-center">
                            <div class="text-muted" style="font-size:0.78rem;">Eventos (<%= days %>d)</div>
                            <div class="fw-bold" style="font-size:2rem; color:var(--primary-color);"><%= totalEvents %></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-body text-center">
                            <div class="text-muted" style="font-size:0.78rem;">Usuários únicos</div>
                            <div class="fw-bold" style="font-size:2rem; color:var(--primary-color);"><%= uniqueUsers %></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-body text-center">
                            <div class="text-muted" style="font-size:0.78rem;">View → Pagou</div>
                            <div class="fw-bold" style="font-size:2rem; color:var(--success-color);"><%= conversion %>%</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-body text-center">
                            <div class="text-muted" style="font-size:0.78rem;">Checkout &rarr; Comprou</div>
                            <% var convColor = parseFloat(checkoutConversion) >= 10 ? 'var(--success-color)' : '#f59e0b'; %>
                            <div class="fw-bold" <%- `style="font-size:2rem; color:${convColor};"` %>><%= checkoutConversion %>%</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row 1: Evolução Diária + Funil de Conversão -->
            <div class="row g-4 mb-4">
                <!-- Linha diária -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Evolução Diária</h5>
                            <div class="d-flex gap-2 align-items-center" style="font-size:0.75rem;">
                                <span class="badge" style="background:#6366f1;">Total</span>
                                <span class="badge" style="background:#f59e0b;">Checkouts</span>
                                <span class="badge" style="background:#10b981;">Pagamentos</span>
                                <span class="badge" style="background:#ef4444;">Verificações</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="dailyChart" height="220"></canvas>
                        </div>
                    </div>
                </div>
                <!-- Funil de conversão (barra horizontal) -->
                <div class="col-md-5">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <h5 class="mb-0">Funil de Conversão</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="funnelChart" height="300"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row 2: Heatmap por hora + Por tela -->
            <div class="row g-4 mb-4">
                <!-- Heatmap por hora -->
                <div class="col-md-5">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <h5 class="mb-0">Horário de maior atividade</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="hourChart" height="200"></canvas>
                        </div>
                    </div>
                </div>
                <!-- Por tela -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <h5 class="mb-0">Por tela (últimos <%= days %> dias)</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="max-height:280px; overflow-y:auto;">
                                <table class="table table-hover align-middle mb-0" style="font-size:0.85rem;">
                                    <thead class="sticky-top bg-white">
                                        <tr>
                                            <th>Tela</th>
                                            <th class="text-end">Views</th>
                                            <th class="text-end">QRs</th>
                                            <th class="text-end">"Já paguei"</th>
                                            <th class="text-end">Conv.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (screenStats && screenStats.length > 0) { %>
                                            <% screenStats.forEach(function(s) { %>
                                                <tr>
                                                    <td><code><%= s.screen %></code></td>
                                                    <td class="text-end"><%= s.views %></td>
                                                    <td class="text-end"><%= s.qr %></td>
                                                    <td class="text-end fw-bold"><%= s.verifies %></td>
                                                    <td class="text-end"><span class="badge <%= parseFloat(s.viewToVerify) >= 5 ? 'bg-success' : 'bg-secondary' %>"><%= s.viewToVerify %>%</span></td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr><td colspan="5" class="text-center text-muted py-4">Sem dados no período.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Por campanha (atribuição) -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <h5 class="mb-0">Por campanha (últimos <%= days %> dias)</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="max-height:280px; overflow-y:auto;">
                                <table class="table table-hover align-middle mb-0" style="font-size:0.82rem;">
                                    <thead class="sticky-top bg-white">
                                        <tr>
                                            <th>Campanha / Origem</th>
                                            <th class="text-end">Pag.</th>
                                            <th class="text-end">Check.</th>
                                            <th class="text-end">Conv.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof campaignStats !== 'undefined' && campaignStats && campaignStats.length > 0) { %>
                                            <% campaignStats.forEach(function(c) { %>
                                                <tr>
                                                    <td><code style="font-size:0.75rem;"><%= c.campaign %></code><%- c.source ? `<div class="text-muted" style="font-size:0.72rem;">${c.source.replace(/</g, '&lt;')}</div>` : '' %></td>
                                                    <td class="text-end fw-bold"><%= c.purchases %></td>
                                                    <td class="text-end"><%= c.checkouts %></td>
                                                    <td class="text-end"><span class="badge <%= parseFloat(c.conversion) >= 5 ? 'bg-success' : 'bg-secondary' %>"><%= c.conversion %>%</span></td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr><td colspan="4" class="text-center text-muted py-4">Sem dados de campanha no período.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pixels de marketing — SOMENTE MASTER -->
            <% if (typeof isMaster !== 'undefined' && isMaster) { %>
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Pixels de marketing <span class="badge bg-dark ms-1" style="font-size:0.68rem;">só mestre</span></h5>
                            <span class="text-muted" style="font-size:0.75rem;">IDs saídos daqui alimentam o site (com consentimento LGPD)</span>
                        </div>
                        <div class="card-body">
                            <form method="POST" action="/admin/tracking/pixels">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <div class="row g-3">
                                    <% (typeof pixelConfigs !== 'undefined' ? pixelConfigs : []).forEach(function(p) { %>
                                        <div class="col-md-4">
                                            <div class="border rounded p-3 h-100" style="border-radius:12px;">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <strong style="font-size:0.9rem;"><%= p.label %></strong>
                                                    <% if (p.enabled && p.pixelId) { %>
                                                        <span class="badge bg-success">Ativo</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">Inativo</span>
                                                    <% } %>
                                                </div>
                                                <label class="form-label text-muted" style="font-size:0.75rem;">ID do pixel</label>
                                                <input type="text" class="form-control form-control-sm mb-2" name="pixelId[<%= p.provider %>]" value="<%= p.pixelId %>" placeholder="<%= p.hint %>" maxlength="64" autocomplete="off">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="en-<%= p.provider %>" name="enabled[<%= p.provider %>]" <%= p.enabled ? 'checked' : '' %>>
                                                    <label class="form-check-label" style="font-size:0.82rem;" for="en-<%= p.provider %>">Ativado</label>
                                                </div>
                                                <div class="text-muted mt-1" style="font-size:0.72rem;"><%= p.hint %></div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                                <div class="mt-3 d-flex gap-2 align-items-center">
                                    <button type="submit" class="btn btn-primary btn-sm">Salvar pixels</button>
                                    <span class="text-muted" style="font-size:0.75rem;">Sem ID ou desativado = pixel não carrega no site. Tokens (CAPI/MP) continuam só no `.env` do servidor.</span>
                                </div>
                            </form>

                            <hr>
                            <h6 class="mb-2">O que está sendo capturado</h6>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <% (typeof pixelStats !== 'undefined' ? pixelStats : []).forEach(function(s) { %>
                                    <span class="badge rounded-pill bg-light text-dark border" style="font-size:0.75rem;"><%= s.event %>: <strong><%= s.count %></strong> <span class="text-muted">(7d)</span></span>
                                <% }); %>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" style="font-size:0.8rem;">
                                    <thead>
                                        <tr>
                                            <th>Evento interno</th>
                                            <th>Google (GA4)</th>
                                            <th>Meta</th>
                                            <th>TikTok</th>
                                            <th>Servidor (CAPI/MP)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><code>VIEW_ITEM</code></td><td>view_item</td><td>ViewContent</td><td>ViewContent</td><td>CAPI ViewContent</td></tr>
                                        <tr><td><code>ADD_TO_CART</code></td><td>add_to_cart</td><td>AddToCart</td><td>AddToCart</td><td>CAPI AddToCart</td></tr>
                                        <tr><td><code>BEGIN_CHECKOUT</code></td><td>begin_checkout</td><td>InitiateCheckout</td><td>InitiateCheckout</td><td>CAPI InitiateCheckout</td></tr>
                                        <tr><td><code>PAYMENT_CONFIRMED_VIEW</code></td><td>purchase</td><td>Purchase</td><td>CompletePayment</td><td>CAPI Purchase</td></tr>
                                        <tr><td><code>REGISTER</code></td><td>sign_up</td><td>CompleteRegistration</td><td>CompleteRegistration</td><td>CAPI CompleteRegistration</td></tr>
                                        <tr><td><code>LOGIN</code></td><td>login</td><td class="text-muted">—</td><td class="text-muted">—</td><td class="text-muted">—</td></tr>
                                        <tr><td><code>SEARCH</code></td><td>search</td><td>Search</td><td class="text-muted">—</td><td class="text-muted">—</td></tr>
                                        <tr><td><code>KYC_SUBMITTED</code></td><td>kyc_submitted</td><td>SubmitApplication</td><td class="text-muted">—</td><td class="text-muted">—</td></tr>
                                        <tr><td><code>BID_CREATED</code></td><td>bid_created</td><td class="text-muted">—</td><td class="text-muted">—</td><td class="text-muted">—</td></tr>
                                        <tr><td><code>SCREEN_VIEW</code></td><td>page_view</td><td>PageView</td><td>page</td><td class="text-muted">—</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <p class="text-muted mt-2 mb-0" style="font-size:0.75rem;">
                                Como captura: (1) no navegador via <code>fbq</code>/<code>gtag</code>/<code>ttq</code> após o aceite de marketing;
                                (2) no servidor via Meta CAPI + GA4 MP com o mesmo <code>event_id</code> (deduplicação automática);
                                (3) cada evento carrega UTM/campanha, <code>fbp</code>/<code>fbc</code> e valor em BRL. Sem PII.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Top entidades + Funil tabela -->
            <div class="row g-4 mb-4">
                <!-- Top entidades -->
                <div class="col-md-5">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <h5 class="mb-0">Top Entidades</h5>
                        </div>
                        <div class="card-body">
                            <% if (topEntities && topEntities.length > 0) { %>
                                <% topEntities.forEach(function(t) { %>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span><code style="font-size: 0.73rem;"><%= t.type %>:<%= String(t.id).slice(0, 10) %></code></span>
                                        <div class="d-flex gap-1">
                                            <span class="badge rounded-pill" style="background:#6366f1;" title="Views/QRs"><%= t.qr %></span>
                                            <span class="badge bg-warning rounded-pill" title="Verificou pagamento"><%= t.verifies %></span>
                                            <span class="badge bg-success rounded-pill" title="Confirmou pagamento"><%= t.purchases %></span>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p class="text-muted mb-0">Sem movimento no período.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
                <!-- Funil completo (todos os eventos) -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <h5 class="mb-0">Funil completo — todos os eventos</h5>
                        </div>
                        <div class="card-body">
                            <% const maxCount = Math.max(1, ...funnel.map(f => f.count)); %>
                            <div class="table-responsive" style="max-height:280px; overflow-y:auto;">
                                <table class="table table-hover align-middle mb-0" style="font-size:0.82rem;">
                                    <thead class="sticky-top bg-white">
                                        <tr>
                                            <th>Evento</th>
                                            <th class="text-end">Total</th>
                                            <th style="width:40%;">Proporção</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% funnel.forEach(function(f) { %>
                                            <tr>
                                                <td><code style="font-size:0.75rem;"><%= f.event %></code></td>
                                                <td class="text-end fw-bold"><%= f.count %></td>
                                                <td>
                                                    <div class="progress" style="height: 8px; border-radius: 6px;">
                                                        <% var barW = Math.round((f.count / maxCount) * 100); %>
                                                        <div class="progress-bar" role="progressbar" <%- `style="width:${barW}%;"` %>></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Eventos recentes -->
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Eventos recentes</h5>
                    <form method="GET" action="/admin/tracking" class="d-flex gap-2">
                        <input type="hidden" name="days" value="<%= days %>">
                        <select name="screen" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Todas as telas</option>
                            <% knownScreens.forEach(function(s) { %>
                                <option value="<%= s %>" <%= screenFilter === s ? 'selected' : '' %>><%= s %></option>
                            <% }); %>
                        </select>
                        <select name="event" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Todos os eventos</option>
                            <% funnelOrder.forEach(function(e) { %>
                                <option value="<%= e %>" <%= eventFilter === e ? 'selected' : '' %>><%= e %></option>
                            <% }); %>
                        </select>
                    </form>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size:0.82rem;">
                            <thead>
                                <tr>
                                    <th>Quando</th>
                                    <th>Evento</th>
                                    <th>Tela</th>
                                    <th>Entidade</th>
                                    <th>Usuário</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (recent && recent.length > 0) { %>
                                    <% recent.forEach(function(ev) { %>
                                        <tr>
                                            <td class="text-muted" style="white-space:nowrap;"><%= new Date(ev.createdAt).toLocaleString('pt-BR') %></td>
                                            <td>
                                                <% const badgeColor = ev.event === 'PAYMENT_CONFIRMED_VIEW' ? 'bg-success' : ev.event === 'BEGIN_CHECKOUT' ? 'bg-warning text-dark' : ev.event === 'VIEW_ITEM' ? 'bg-info text-dark' : 'bg-secondary'; %>
                                                <span class="badge <%= badgeColor %>" style="font-size:0.7rem;"><%= ev.event %></span>
                                            </td>
                                            <td><%= ev.screen || '—' %></td>
                                            <td style="font-size:0.75rem;"><%= ev.entityType ? (ev.entityType + ':' + String(ev.entityId || '').slice(0, 8)) : '—' %></td>
                                            <td class="text-muted" style="font-size:0.78rem;"><%= ev.userId ? String(ev.userId).slice(0, 8) : 'anônimo' %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center text-muted py-4">Nenhum evento no período.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

<!-- Dados do servidor embutidos como JSON seguro (sem EJS dentro de <script>) -->
<script type="application/json" id="__daily__"><%- JSON.stringify(dailySeries) %></script>
<script type="application/json" id="__hours__"><%- JSON.stringify(hourCounts) %></script>
<script type="application/json" id="__funnel__"><%- JSON.stringify(funnel) %></script>

<!-- Chart.js via CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function() {
    // Lê os dados embutidos — sem EJS misturado com JS
    const daily     = JSON.parse(document.getElementById('__daily__').textContent);
    const hourData  = JSON.parse(document.getElementById('__hours__').textContent);
    const funnelData = JSON.parse(document.getElementById('__funnel__').textContent);

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
    const tickColor = isDark ? '#9ca3af' : '#6b7280';

    Chart.defaults.font.family = "'Inter', 'Outfit', sans-serif";
    Chart.defaults.font.size = 11;

    // ── 1. Gráfico de linha: Evolução Diária ────────────────────────────────
    new Chart(document.getElementById('dailyChart'), {
        type: 'line',
        data: {
            labels: daily.map(d => d.day),
            datasets: [
                {
                    label: 'Total',
                    data: daily.map(d => d.total),
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99,102,241,0.08)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 3,
                    borderWidth: 2
                },
                {
                    label: 'Checkouts',
                    data: daily.map(d => d.checkouts),
                    borderColor: '#f59e0b',
                    backgroundColor: 'transparent',
                    tension: 0.4,
                    pointRadius: 3,
                    borderWidth: 2,
                    borderDash: [4, 3]
                },
                {
                    label: 'Pagamentos',
                    data: daily.map(d => d.purchases),
                    borderColor: '#10b981',
                    backgroundColor: 'transparent',
                    tension: 0.4,
                    pointRadius: 3,
                    borderWidth: 2
                },
                {
                    label: 'Verificações',
                    data: daily.map(d => d.verifies),
                    borderColor: '#ef4444',
                    backgroundColor: 'transparent',
                    tension: 0.4,
                    pointRadius: 2,
                    borderWidth: 1.5,
                    borderDash: [3, 3]
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: gridColor }, ticks: { color: tickColor } },
                y: { grid: { color: gridColor }, ticks: { color: tickColor }, beginAtZero: true }
            }
        }
    });

    // ── 2. Gráfico de barra horizontal: Funil ──────────────────────────────
    const MAX_FUNNEL = 10; // Mostra os 10 maiores
    const sortedFunnel = [...funnelData].sort((a, b) => b.count - a.count).slice(0, MAX_FUNNEL);
    new Chart(document.getElementById('funnelChart'), {
        type: 'bar',
        data: {
            labels: sortedFunnel.map(f => f.event.replace(/_/g, ' ')),
            datasets: [{
                label: 'Ocorrências',
                data: sortedFunnel.map(f => f.count),
                backgroundColor: [
                    '#6366f1','#8b5cf6','#a78bfa','#10b981','#34d399',
                    '#f59e0b','#fbbf24','#ef4444','#f87171','#06b6d4'
                ],
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: gridColor }, ticks: { color: tickColor }, beginAtZero: true },
                y: { grid: { display: false }, ticks: { color: tickColor, font: { size: 10 } } }
            }
        }
    });

    // ── 3. Heatmap por hora (barra) ─────────────────────────────────────────
    const maxHour = Math.max(1, ...hourData.map(h => h.count));
    new Chart(document.getElementById('hourChart'), {
        type: 'bar',
        data: {
            labels: hourData.map(h => `${String(h.hour).padStart(2,'0')}h`),
            datasets: [{
                label: 'Eventos',
                data: hourData.map(h => h.count),
                backgroundColor: hourData.map(h => {
                    const intensity = h.count / maxHour;
                    return `rgba(99,102,241,${0.15 + intensity * 0.75})`;
                }),
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { color: tickColor, font: { size: 9 } } },
                y: { grid: { color: gridColor }, ticks: { color: tickColor }, beginAtZero: true }
            }
        }
    });

    // Atualiza gráficos ao trocar tema
    document.addEventListener('themeChanged', () => { location.reload(); });
})();
</script>

