generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  cpf           String    @unique
  birthDate     DateTime?
  phone         String?
  passwordHash  String
  role          String    @default("CLIENT") // MASTER, MANAGER, SUPPORT, CLIENT
  twoFactorSecret String? // Segredo 2FA local
  twoFactorEnabled Boolean @default(false)
  address       String?   // JSON stringified address
  documentFrontUrl String?
  documentBackUrl  String?
  selfieUrl        String?
  
  // KYC Verification
  kycStatus       String    @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED
  kycReviewedAt   DateTime?
  kycReviewedBy   String?   // Admin userId who reviewed
  kycRejectReason String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  supportTickets SupportTicket[]
  notifications Notification[]

  @@map("users")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  description   String
  type          String    // MOTO, CARRO, CARTA_CREDITO, ELETRONICO, IMOVEL, SERVICO
  category      String    // Sub-category: sport, sedan, gaming, reforma, etc.
  imageUrl      String
  imageUrls     String    // JSON stringified array of URLs
  // Fotos conferidas por humano (extração por IA precisa de revisão) — JSON array de paths
  verifiedImageUrls String? // (dev) fotos marcadas como verificadas
  price         Decimal
  active        Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  isPopular     Boolean   @default(false)
  // Ordem de exibição no catálogo (menor = aparece primeiro)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Universal optional fields
  brand         String?
  model         String?
  year          Int?

  // Flexible specs — JSON with type-specific details
  // For MOTO: { displacement, power, torque, transmission, engineType, ... }
  // For CARRO: { motor, potencia, cambio, combustivel, portas, ... }
  // For CARTA_CREDITO: { finalidade, restricoes, ... }
  // For ELETRONICO: { processador, ram, armazenamento, ... }
  specs         String?

  // Auto-generation configuration
  minDuration   Int       @default(12)
  maxDuration   Int       @default(60)
  adminFeeRate  Decimal   @default(15.0)

  plans         ConsortiumPlan[]

  @@map("products")
}

model ConsortiumPlan {
  id              String    @id @default(uuid())
  name            String
  durationMonths  Int
  adminFeeRate    Decimal   // Taxa administrativa % (ex: 15.0)
  fundRate        Decimal   // Fundo de reserva % (ex: 2.0)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  active          Boolean   @default(true)
  
  subscriptions   Subscription[]

  @@map("consortium_plans")
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              ConsortiumPlan @relation(fields: [planId], references: [id])
  
  // Consortium Info
  groupNumber       String    // Grupo do consórcio
  quotaNumber       String    // Cota do consórcio
  creditValue       Decimal   // Valor do crédito/bem
  
  status            String    @default("PENDING") // PENDING, PENDING_KYC, ACTIVE, CONTEMPLATED, COMPLETED, CANCELLED
  contemplated      Boolean   @default(false)
  contemplationDate DateTime?
  contemplatedDate DateTime?
  contemplationType String?   // BID, DRAW, DIRECT (lance, sorteio, direto)
  
  // Digital Signature
  termsAccepted     Boolean   @default(false)
  termsAcceptedAt   DateTime?
  termsIpAddress    String?
  
  balanceDue        Decimal   // Quanto falta pagar
  paidInstallments  Int       @default(0)
  totalInstallments Int       // Total de parcelas do plano
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  installments      Installment[]
  bids              Bid[]
  supportTickets    SupportTicket[]
  batches           PaymentBatch[]

  @@index([groupNumber, quotaNumber])
  @@index([userId, status])
  @@map("subscriptions")
}

model Installment {
  id              String    @id @default(uuid())
  idTokenPay      String    @unique @default(uuid()) // Signed payment token (client+contract+installment)
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  number          Int       // Parcela 1, 2, 3...
  amount          Decimal
  dueDate         DateTime
  status          String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED, REFUNDED
  paymentDate     DateTime?
  paymentMethod   String?   // PIX, BOLETO, CARTAO, DINHEIRO
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paymentAttempts PaymentAttempt[]

  @@index([idTokenPay])
  @@map("installments")
}

model Bid {
  id              String    @id @default(uuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  type            String    // FREE (Lance Livre), FIXED (Lance Fixo)
  percentage      Decimal   // Percentual oferecido (5% a 50%)
  amount          Decimal   // Valor calculado do lance
  
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CONTEMPLATED
  isWinner        Boolean   @default(false)
  
  drawDate        DateTime? // Data do sorteio onde este lance participou
  contemplatedDate DateTime? // Data em que foi contemplado
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payments        BidPayment[]

  @@map("bids")
}

// Cobranças PIX geradas para lances (B5 — antes eram órfãs: `installmentId='bid-<uuid>'`
// sem registro, sem idempotência e sem liquidação no webhook).
// status: RESERVED (emissão em andamento) → ACTIVE (voucher válido) → PAID (liquidado)
//         | EXPIRED (substituído/vencido) | CANCELLED (lance cancelado — voucher invalidado)
model BidPayment {
  id            String    @id @default(uuid())
  bidId         String
  bid           Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)

  provider      String    // eldorado, g2g, pixgo, sigilopay, sandbox
  externalId    String?   // paymentId no provedor
  amount        Decimal
  status        String    @default("ACTIVE")
  copyPaste     String?   // PIX copia-e-cola (permite reexibir sem gerar nova cobrança)
  expiresAt     DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bidId, status])
  @@map("bid_payments")
}

// Pixel próprio — funil produto/ads (SCREEN_VIEW, GENERATE_QR_CLICK,
// COPY_PIX_CLICK, VERIFY_PAYMENT_CLICK etc.). Tabela leve, sem PII além do
// userId; userAgent/IP truncados. Base p/ melhorar algoritmo e campanhas.
model TrackingEvent {
  id          String   @id @default(uuid())
  userId      String?  // dono (do JWT); null = anônimo/opt-out futuro
  event       String   // SCREEN_VIEW | GENERATE_QR_CLICK | QR_SHOWN | COPY_PIX_CLICK | VERIFY_PAYMENT_CLICK | PAYMENT_CONFIRMED_VIEW
  screen      String?  // welcome | bids | payment | checkout | contracts | payments | kyc | products
  entityType  String?  // bid | installment | subscription
  entityId    String?  // uuid da entidade (quando houver)
  metadata    String?  // JSON pequeno (≤2KB, validado no zod)
  ipAddress   String?
  userAgent   String?  // truncado em 512
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@map("tracking_events")
}

// Pesos do algoritmo de aprendizado (loop estilo TikTok, versão consórcio).
// Atualizados ONLINE a cada evento do pixel (EMA/contadores) e lidos pelo
// GET /api/recommendations e pelo dashboard. scope: 'global' ou userId.
model LearningWeight {
  id        String   @id @default(uuid())
  scope     String   // 'global' | userId
  key       String   // aff:PROD:<id> | pop:PROD:<id> | prop:verify | conv:qr_verify ...
  value     Float    @default(0)
  samples   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@map("learning_weights")
}

// Notificações in-app do cliente (ex: KYC recusado → reenviar documentos).
// Criadas pelo servidor (admin/sistema); o app lista e marca como lidas.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // KYC_REJECTED (extensível)
  title     String
  message   String
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // LOGIN, UPDATE_PRICE, CREATE_USER, CONTEMPLATE_BID, etc
  resource    String   // table name or entity
  details     String?  // JSON details
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}

// ========================================
// SECURITY - Threat Detection System
// ========================================

model SecurityThreat {
  id          String   @id @default(uuid())
  ipAddress   String
  deviceId    String?
  deviceModel String?
  userId      String?
  
  threatType  String   // HONEYPOT, BRUTE_FORCE, IDOR, INJECTION, INVALID_TOKEN, RATE_LIMIT
  threatScore Int      // Pontuação da ameaça
  requestPath String
  requestMethod String
  userAgent   String?
  details     String?  // JSON com detalhes do ataque
  
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("security_threats")
}

model BlockedDevice {
  id          String    @id @default(uuid())
  deviceId    String?
  ipAddress   String?
  reason      String
  threatScore Int       @default(0)
  
  permanent   Boolean   @default(true)  // Só admin pode desbloquear
  active      Boolean   @default(true)
  unblockedAt DateTime?
  unblockedBy String?
  
  blockedAt   DateTime  @default(now())

  @@unique([deviceId])
  @@map("blocked_devices")
}

// ========================================
// PAYMENT GATEWAY CONFIGURATION
// ========================================

model GatewayConfig {
  id            String   @id @default(uuid())
  name          String   @unique  // "pixgo", "sigilopay"
  displayName   String             // "PixGo", "SigiloPay"
  enabled       Boolean  @default(false)
  apiKey        String?            // API Key do gateway
  apiSecret     String?            // Secret/Token adicional
  webhookSecret String?            // Webhook secret para validação
  baseUrl       String?            // URL base da API
  environment   String   @default("sandbox") // "sandbox" ou "production"
  platformId    String?            // ID da plataforma (SigiloPay)
  
  // Quais métodos de pagamento este gateway suporta
  supportsPix     Boolean @default(true)
  supportsBoleto  Boolean @default(false)
  supportsCard    Boolean @default(false)

  // Baixa manual: valor cai na conta da operação e gerente confirma na Central.
  // Configurado na tela /admin/gateways; exibido no app só quando a gateway usada for manual.
  requiresManualReview Boolean @default(false)
  
  // Definir como gateway padrão para cada método
  isDefaultPix    Boolean @default(false)
  isDefaultBoleto Boolean @default(false)
  isDefaultCard   Boolean @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("gateway_configs")
}

model WebhookLog {
  id              String   @id @default(uuid())
  signature       String   @unique
  provider        String   // "pixgo", "sigilopay"
  providerEventId String?
  status          String   @default("PROCESSED") // "RECEIVED", "PROCESSED", "FAILED"
  payload         String?  // Optional payload dump for debug
  errorMessage    String?
  attempts        Int      @default(1)
  receivedAt      DateTime @default(now())
  processedAt     DateTime @default(now())

  @@map("webhook_logs")
}

model SystemAlert {
  id              String    @id @default(uuid())
  type            String    // GATEWAY_FAILOVER, GATEWAY_ERROR, PAYMENT_FAILURE, SECURITY
  severity        String    @default("WARNING") // INFO, WARNING, CRITICAL
  title           String
  message         String
  details         String?   // JSON com metadados: customerId, customerName, customerCpf, amount, failedGateway, errorReason, fallbackGateway, etc.
  read            Boolean   @default(false)
  readAt          DateTime?
  readBy          String?   // Admin userId
  // Fila operacional (Central de Notificações — fase 1)
  status          String    @default("OPEN") // OPEN, ACK, IN_PROGRESS, RESOLVED, DISMISSED
  assignedTo      String?   // Admin userId dono do atendimento
  assignedAt      DateTime?
  resolvedAt      DateTime?
  entityKind      String?   // subscription, bid, bidPayment, installment, user
  entityId        String?
  claimToken      String?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
  @@index([assignedTo, status])
  @@index([entityKind, entityId])
  @@map("system_alerts")
}

model SupportTicket {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  type           String    @default("CANCELLATION") // CANCELLATION, PAYMENT, OTHER
  subject        String
  message        String
  status         String    @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  adminReply     String?
  repliedBy      String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model PaymentAttempt {
  id            String    @id @default(uuid())
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         PaymentBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  provider      String    // eldorado, g2g, pixgo, sigilopay, sandbox
  externalId    String?   // paymentId no provedor
  amount        Decimal
  status        String    @default("ACTIVE") // ACTIVE, EXPIRED, PAID
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([installmentId, status])
  @@index([batchId, status])
  @@map("payment_attempts")
}

// Cobrança combinada: 1 PIX somando N parcelas (adesão, do mês, antecipações).
model PaymentBatch {
  id             String    @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  installmentIds String    // JSON: ["uuid", ...] ordenados
  totalAmount    Decimal
  provider       String    @default("pending")
  externalId     String?
  copyPaste      String?
  status         String    @default("RESERVED") // RESERVED, ACTIVE, PAID, EXPIRED, CANCELLED
  expiresAt      DateTime?
  paidAt         DateTime?
  attempts       PaymentAttempt[]
  createdAt      DateTime  @default(now())

  @@index([subscriptionId, status])
  @@map("payment_batches")
}
