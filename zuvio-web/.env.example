# Porta do Nuxt Web App
PORT=3001

# URL interna do Backend Katari (server-consorcio) — apenas lida no servidor Nuxt (BFF)
# Esta variável NUNCA é exposta ao navegador.
NUXT_BACKEND_BASE=http://localhost:3000

# HMAC p/ assinar chamadas BFF→backend (server-only, nunca hardcoded).
# Idêntico ao REQUEST_SIGNING_SECRET do backend. Gere com: openssl rand -hex 32
NUXT_HMAC_SECRET=change_me_64_hex_chars
