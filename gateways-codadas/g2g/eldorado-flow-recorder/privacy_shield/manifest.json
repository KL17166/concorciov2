{
  "manifest_version": 3,
  "name": "Privacy Shield Pro",
  "version": "2.0",
  "description": "Limpeza Profunda e Mascaramento Avançado de Fingerprint (WebGL, Canvas, Áudio, Fontes e WebRTC)",
  "permissions": [
    "browsingData",
    "scripting",
    "activeTab",
    "tabs",
    "privacy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Shield Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
